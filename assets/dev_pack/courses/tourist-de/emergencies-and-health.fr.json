{"schema_version":1,"course":"tourist-de","unit":"emergencies-and-health","language":"fr","target_language":"de","phrases":[{"concept":"help","text":{"Latn":"Au secours !"}},{"concept":"call-the-police","text":{"Latn":"Appelez la police !"}},{"concept":"call-an-ambulance","text":{"Latn":"Appelez une ambulance !"}},{"concept":"i-need-a-doctor","text":{"Latn":"Il me faut un médecin"}},{"concept":"where-is-the-pharmacy","text":{"Latn":"Où est la pharmacie ?"}},{"concept":"where-is-the-hospital","text":{"Latn":"Où est l'hôpital ?"}},{"concept":"i-feel-sick","text":{"Latn":"Je me sens mal"}},{"concept":"please-help-me","text":{"Latn":"Aidez-moi, s'il vous plaît"}},{"concept":"stop-thief","text":{"Latn":"Au voleur !"}},{"concept":"it-hurts-here","text":{"Latn":"J'ai mal ici"}}],"glosses":[{"lemma":"de:hilfe","gloss":"aide, secours"},{"lemma":"de:rufen","gloss":"appeler"},{"lemma":"de:sie","gloss":"vous (politesse) ; elle ; ils, elles","note":"Avec une majuscule, « Sie » est le « vous » de politesse, au singulier comme au pluriel, employé avec les inconnus."},{"lemma":"de:der","gloss":"le, la, les","note":"Der (masculin), die (féminin), das (neutre), die (pluriel). « Den » est le masculin après des verbes comme « nehmen » ou « haben »."},{"lemma":"de:polizei","gloss":"police"},{"lemma":"de:ein","gloss":"un, une","note":"Ein (masculin, neutre), eine (féminin) ; « einen » est le masculin pour ce que l'on demande ou prend."},{"lemma":"de:krankenwagen","gloss":"ambulance"},{"lemma":"de:ich","gloss":"je","note":"« Mir » est la forme employée après des verbes comme « helfen » : « Helfen Sie mir »."},{"lemma":"de:brauchen","gloss":"avoir besoin de"},{"lemma":"de:arzt","gloss":"médecin"},{"lemma":"de:wo","gloss":"où"},{"lemma":"de:sein","gloss":"être"},{"lemma":"de:apotheke","gloss":"pharmacie"},{"lemma":"de:krankenhaus","gloss":"hôpital"},{"lemma":"de:schlecht","gloss":"mauvais ; mal (nausée)","note":"« Mir ist schlecht » signifie « j'ai mal au cœur », au sens de la nausée."},{"lemma":"de:helfen","gloss":"aider"},{"lemma":"de:bitte","gloss":"s'il vous plaît","note":"Signifie « s'il vous plaît », et aussi « de rien » en réponse à « danke »."},{"lemma":"de:halt","gloss":"stop !"},{"lemma":"de:dieb","gloss":"voleur"},{"lemma":"de:hier","gloss":"ici"},{"lemma":"de:wehtun","gloss":"faire mal","note":"Verbe à particule séparable : « Hier tut es weh » signifie « J'ai mal ici »."},{"lemma":"de:es","gloss":"il, ça"}]}
