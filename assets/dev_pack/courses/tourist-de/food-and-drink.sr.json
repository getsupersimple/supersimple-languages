{"schema_version":1,"course":"tourist-de","unit":"food-and-drink","language":"sr","target_language":"de","phrases":[{"concept":"one-coffee-please","text":{"Latn":"Jednu kafu, molim","Cyrl":"Једну кафу, молим"}},{"concept":"water-please","text":{"Latn":"Čašu vode, molim","Cyrl":"Чашу воде, молим"}},{"concept":"table-for-two","text":{"Latn":"Sto za dvoje, molim","Cyrl":"Сто за двоје, молим"}},{"concept":"the-menu-please","text":{"Latn":"Jelovnik, molim","Cyrl":"Јеловник, молим"}},{"concept":"the-bill-please","text":{"Latn":"Račun, molim","Cyrl":"Рачун, молим"}},{"concept":"i-dont-eat-meat","text":{"Latn":"Ne jedem meso","Cyrl":"Не једем месо"}},{"concept":"without-nuts-please","text":{"Latn":"Bez oraha, molim","Cyrl":"Без ораха, молим"}},{"concept":"what-do-you-recommend","text":{"Latn":"Šta preporučujete?","Cyrl":"Шта препоручујете?"}},{"concept":"delicious","text":{"Latn":"Ukusno!","Cyrl":"Укусно!"}},{"concept":"a-beer-please","text":{"Latn":"Jedno pivo, molim","Cyrl":"Једно пиво, молим"}},{"concept":"cheers","text":{"Latn":"Živeli!","Cyrl":"Живели!"}}],"glosses":[{"lemma":"de:ein","gloss":"(neodređeni član); jedan","note":"Ein (muški, srednji), eine (ženski); „einen“ je muški oblik za ono što tražite ili uzimate."},{"lemma":"de:kaffee","gloss":"kafa"},{"lemma":"de:bitte","gloss":"molim","note":"Znači „molim“, a takođe i „nema na čemu“ kao odgovor na „danke“."},{"lemma":"de:glas","gloss":"čaša"},{"lemma":"de:wasser","gloss":"voda"},{"lemma":"de:tisch","gloss":"sto"},{"lemma":"de:fur","gloss":"za"},{"lemma":"de:zwei","gloss":"dva"},{"lemma":"de:der","gloss":"(određeni član)","note":"Der (muški), die (ženski), das (srednji), die (množina). „Den“ je muški oblik posle glagola kao što su „nehmen“ i „haben“."},{"lemma":"de:speisekarte","gloss":"jelovnik"},{"lemma":"de:rechnung","gloss":"račun"},{"lemma":"de:ich","gloss":"ja","note":"„Mir“ je oblik posle glagola kao što je „helfen“: „Helfen Sie mir“."},{"lemma":"de:essen","gloss":"jesti"},{"lemma":"de:kein","gloss":"nijedan, nikakav","note":"Odriče imenicu: „Ich esse kein Fleisch“. Glagoli i pridevi se odriču sa „nicht“."},{"lemma":"de:fleisch","gloss":"meso"},{"lemma":"de:ohne","gloss":"bez"},{"lemma":"de:nuss","gloss":"orah"},{"lemma":"de:was","gloss":"šta"},{"lemma":"de:empfehlen","gloss":"preporučiti"},{"lemma":"de:sie","gloss":"Vi (učtivo); ona; oni","note":"Napisano velikim slovom, „Sie“ je učtivo „Vi“, za jednu osobu ili više njih, u razgovoru sa nepoznatima."},{"lemma":"de:lecker","gloss":"ukusan"},{"lemma":"de:bier","gloss":"pivo"},{"lemma":"de:prost","gloss":"živeli!"}]}
