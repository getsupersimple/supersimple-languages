{"schema_version":1,"course":"tourist-de","unit":"essentials-and-politeness","language":"fr","target_language":"de","phrases":[{"concept":"yes","text":{"Latn":"Oui"}},{"concept":"no","text":{"Latn":"Non"}},{"concept":"please","text":{"Latn":"S'il vous plaît"}},{"concept":"excuse-me","text":{"Latn":"Excusez-moi"}},{"concept":"sorry","text":{"Latn":"Pardon"}},{"concept":"youre-welcome","text":{"Latn":"De rien"}},{"concept":"good-evening","text":{"Latn":"Bonsoir"}},{"concept":"goodbye","text":{"Latn":"Au revoir"}},{"concept":"i-dont-understand","text":{"Latn":"Je ne comprends pas"}},{"concept":"speak-slowly-please","text":{"Latn":"Parlez lentement, s'il vous plaît"}},{"concept":"can-you-repeat","text":{"Latn":"Pouvez-vous répéter ?"}},{"concept":"i-understand","text":{"Latn":"Je comprends"}},{"concept":"what-does-this-mean","text":{"Latn":"Que signifie ça ?"}},{"concept":"i-dont-know","text":{"Latn":"Je ne sais pas"}},{"concept":"no-thank-you","text":{"Latn":"Non, merci"}},{"concept":"thank-you-very-much","text":{"Latn":"Merci beaucoup"}}],"glosses":[{"lemma":"de:ja","gloss":"oui"},{"lemma":"de:nein","gloss":"non"},{"lemma":"de:bitte","gloss":"s'il vous plaît","note":"Signifie « s'il vous plaît », et aussi « de rien » en réponse à « danke »."},{"lemma":"de:entschuldigung","gloss":"excusez-moi ; pardon"},{"lemma":"de:es","gloss":"il, ça"},{"lemma":"de:tun","gloss":"faire"},{"lemma":"de:ich","gloss":"je","note":"« Mir » est la forme employée après des verbes comme « helfen » : « Helfen Sie mir »."},{"lemma":"de:leid","gloss":"désolé (dans « es tut mir leid »)","note":"Seulement dans « Es tut mir leid » (« je suis désolé »), littéralement « cela me fait de la peine »."},{"lemma":"de:gern","gloss":"volontiers","note":"« Gern geschehen » signifie littéralement « volontiers arrivé » : la réponse habituelle à « danke »."},{"lemma":"de:geschehen","gloss":"arriver, se passer"},{"lemma":"de:gut","gloss":"bon"},{"lemma":"de:abend","gloss":"soir"},{"lemma":"de:auf","gloss":"sur, à"},{"lemma":"de:wiedersehen","gloss":"revoir"},{"lemma":"de:verstehen","gloss":"comprendre"},{"lemma":"de:nicht","gloss":"ne… pas, pas"},{"lemma":"de:sprechen","gloss":"parler"},{"lemma":"de:sie","gloss":"vous (politesse) ; elle ; ils, elles","note":"Avec une majuscule, « Sie » est le « vous » de politesse, au singulier comme au pluriel, employé avec les inconnus."},{"lemma":"de:langsam","gloss":"lentement"},{"lemma":"de:konnen","gloss":"pouvoir"},{"lemma":"de:der","gloss":"le, la, les","note":"Der (masculin), die (féminin), das (neutre), die (pluriel). « Den » est le masculin après des verbes comme « nehmen » ou « haben »."},{"lemma":"de:wiederholen","gloss":"répéter"},{"lemma":"de:was","gloss":"que, quoi"},{"lemma":"de:bedeuten","gloss":"signifier"},{"lemma":"de:wissen","gloss":"savoir"},{"lemma":"de:danke","gloss":"merci"},{"lemma":"de:viel","gloss":"beaucoup"},{"lemma":"de:dank","gloss":"merci"}]}
