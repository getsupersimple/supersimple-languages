},{"lemma":"de:nicht","gloss":"not"},{"lemma":"de:sprechen","gloss":"to speak"},{"lemma":"de:sie","gloss":"you (formal); she; they","note":"Written with a capital, “Sie” is the polite “you” for one person or several, used with strangers."},{"lemma":"de:langsam","gloss":"slowly"},{"lemma":"de:konnen","gloss":"can, to be able to"},{"lemma":"de:der","gloss":"the","note":"Der (masculine), die (feminine), das (neuter), die (plural). “Den” is the masculine form after verbs like “nehmen” or “haben”."},{"lemma":"de:wiederholen","gloss":"to repeat"},{"lemma":"de:was","gloss":"what"},{"lemma":"de:bedeuten","gloss":"to mean"},{"lemma":"de:wissen","gloss":"to know"},{"lemma":"de:danke","gloss":"thank you, thanks"},{"lemma":"de:viel","gloss":"much, a lot"},{"lemma":"de:dank","gloss":"thanks, thank you"}]}
