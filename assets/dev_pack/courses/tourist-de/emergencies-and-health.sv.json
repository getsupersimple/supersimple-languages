{"schema_version":1,"course":"tourist-de","unit":"emergencies-and-health","language":"sv","target_language":"de","phrases":[{"concept":"help","text":{"Latn":"Hjälp!"}},{"concept":"call-the-police","text":{"Latn":"Ring polisen!"}},{"concept":"call-an-ambulance","text":{"Latn":"Ring en ambulans!"}},{"concept":"i-need-a-doctor","text":{"Latn":"Jag behöver en läkare"}},{"concept":"where-is-the-pharmacy","text":{"Latn":"Var är apoteket?"}},{"concept":"where-is-the-hospital","text":{"Latn":"Var är sjukhuset?"}},{"concept":"i-feel-sick","text":{"Latn":"Jag mår illa"}},{"concept":"please-help-me","text":{"Latn":"Hjälp mig, tack"}},{"concept":"stop-thief","text":{"Latn":"Stoppa tjuven!"}},{"concept":"it-hurts-here","text":{"Latn":"Det gör ont här"}}],"glosses":[{"lemma":"de:hilfe","gloss":"hjälp"},{"lemma":"de:rufen","gloss":"ropa; ringa efter"},{"lemma":"de:sie","gloss":"ni, Ni; hon; de","note":"Med stor bokstav är „Sie“ det artiga „ni“ för en eller flera personer, som man använder med främlingar."},{"lemma":"de:der","gloss":"den, det (bestämd artikel)","note":"Der (maskulinum), die (femininum), das (neutrum), die (plural). „Den“ är den maskulina formen efter verb som „nehmen“ eller „haben“."},{"lemma":"de:polizei","gloss":"polis"},{"lemma":"de:ein","gloss":"en, ett","note":"Ein (maskulinum, neutrum), eine (femininum); „einen“ är den maskulina formen för det man ber om eller tar."},{"lemma":"de:krankenwagen","gloss":"ambulans"},{"lemma":"de:ich","gloss":"jag","note":"„Mir“ används efter verb som „helfen“: „Helfen Sie mir.“"},{"lemma":"de:brauchen","gloss":"behöva"},{"lemma":"de:arzt","gloss":"läkare"},{"lemma":"de:wo","gloss":"var"},{"lemma":"de:sein","gloss":"vara"},{"lemma":"de:apotheke","gloss":"apotek"},{"lemma":"de:krankenhaus","gloss":"sjukhus"},{"lemma":"de:schlecht","gloss":"dålig; illa (om illamående)","note":"„Mir ist schlecht“ betyder „Jag mår illa“, alltså illamående."},{"lemma":"de:helfen","gloss":"hjälpa"},{"lemma":"de:bitte","gloss":"snälla","note":"Betyder „snälla“ och även „varsågod“ som svar på „danke“."},{"lemma":"de:halt","gloss":"stopp!"},{"lemma":"de:dieb","gloss":"tjuv"},{"lemma":"de:hier","gloss":"här"},{"lemma":"de:wehtun","gloss":"göra ont","note":"Ett separabelt verb: „Hier tut es weh“ är „Det gör ont här“."},{"lemma":"de:es","gloss":"det"}]}
