{"schema_version":1,"course":"tourist-de","unit":"food-and-drink","language":"en","target_language":"de","phrases":[{"concept":"one-coffee-please","text":{"Latn":"One coffee, please"}},{"concept":"water-please","text":{"Latn":"A glass of water, please"}},{"concept":"table-for-two","text":{"Latn":"A table for two, please"}},{"concept":"the-menu-please","text":{"Latn":"The menu, please"}},{"concept":"the-bill-please","text":{"Latn":"The bill, please"}},{"concept":"i-dont-eat-meat","text":{"Latn":"I don't eat meat"}},{"concept":"without-nuts-please","text":{"Latn":"Without nuts, please"}},{"concept":"what-do-you-recommend","text":{"Latn":"What do you recommend?"}},{"concept":"delicious","text":{"Latn":"Delicious!"}},{"concept":"a-beer-please","text":{"Latn":"A beer, please"}},{"concept":"cheers","text":{"Latn":"Cheers!"}}],"glosses":[{"lemma":"de:ein","gloss":"a, an; one","note":"Ein (masculine, neuter), eine (feminine); “einen” is the masculine form for the thing you ask for or take."},{"lemma":"de:kaffee","gloss":"coffee"},{"lemma":"de:bitte","gloss":"please","note":"Means “please”, and also “you’re welcome” in reply to “danke”."},{"lemma":"de:glas","gloss":"glass"},{"lemma":"de:wasser","gloss":"water"},{"lemma":"de:tisch","gloss":"table"},{"lemma":"de:fur","gloss":"for"},{"lemma":"de:zwei","gloss":"two"},{"lemma":"de:der","gloss":"the","note":"Der (masculine), die (feminine), das (neuter), die (plural). “Den” is the masculine form after verbs like “nehmen” or “haben”."},{"lemma":"de:speisekarte","gloss":"menu"},{"lemma":"de:rechnung","gloss":"bill"},{"lemma":"de:ich","gloss":"I","note":"“Mir” is the form used after verbs like “helfen”: “Helfen Sie mir.”"},{"lemma":"de:essen","gloss":"to eat"},{"lemma":"de:kein","gloss":"no, not any","note":"Negates a noun: “Ich esse kein Fleisch.” Verbs and adjectives are negated with “nicht”."},{"lemma":"de:fleisch","gloss":"meat"},{"lemma":"de:ohne","gloss":"without"},{"lemma":"de:nuss","gloss":"nut"},{"lemma":"de:was","gloss":"what"},{"lemma":"de:empfehlen","gloss":"to recommend"},{"lemma":"de:sie","gloss":"you (formal); she; they","note":"Written with a capital, “Sie” is the polite “you” for one person or several, used with strangers."},{"lemma":"de:lecker","gloss":"delicious, tasty"},{"lemma":"de:bier","gloss":"beer"},{"lemma":"de:prost","gloss":"cheers!"}]}
