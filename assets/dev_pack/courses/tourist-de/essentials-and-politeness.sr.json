{"schema_version":1,"course":"tourist-de","unit":"essentials-and-politeness","language":"sr","target_language":"de","phrases":[{"concept":"yes","text":{"Latn":"Da","Cyrl":"Да"}},{"concept":"no","text":{"Latn":"Ne","Cyrl":"Не"}},{"concept":"please","text":{"Latn":"Molim","Cyrl":"Молим"}},{"concept":"excuse-me","text":{"Latn":"Izvinite","Cyrl":"Извините"}},{"concept":"sorry","text":{"Latn":"Žao mi je","Cyrl":"Жао ми је"}},{"concept":"youre-welcome","text":{"Latn":"Nema na čemu","Cyrl":"Нема на чему"}},{"concept":"good-evening","text":{"Latn":"Dobro veče","Cyrl":"Добро вече"}},{"concept":"goodbye","text":{"Latn":"Doviđenja","Cyrl":"Довиђења"}},{"concept":"i-dont-understand","text":{"Latn":"Ne razumem","Cyrl":"Не разумем"}},{"concept":"speak-slowly-please","text":{"Latn":"Govorite polako, molim","Cyrl":"Говорите полако, молим"}},{"concept":"can-you-repeat","text":{"Latn":"Možete li da ponovite?","Cyrl":"Можете ли да поновите?"}},{"concept":"i-understand","text":{"Latn":"Razumem","Cyrl":"Разумем"}},{"concept":"what-does-this-mean","text":{"Latn":"Šta ovo znači?","Cyrl":"Шта ово значи?"}},{"concept":"i-dont-know","text":{"Latn":"Ne znam","Cyrl":"Не знам"}},{"concept":"no-thank-you","text":{"Latn":"Ne, hvala","Cyrl":"Не, хвала"}},{"concept":"thank-you-very-much","text":{"Latn":"Mnogo hvala","Cyrl":"Много хвала"}}],"glosses":[{"lemma":"de:ja","gloss":"da"},{"lemma":"de:nein","gloss":"ne"},{"lemma":"de:bitte","gloss":"molim","note":"Znači „molim“, a takođe i „nema na čemu“ kao odgovor na „danke“."},{"lemma":"de:entschuldigung","gloss":"izvinite; oprostite"},{"lemma":"de:es","gloss":"ono"},{"lemma":"de:tun","gloss":"činiti"},{"lemma":"de:ich","gloss":"ja","note":"„Mir“ je oblik posle glagola kao što je „helfen“: „Helfen Sie mir“."},{"lemma":"de:leid","gloss":"žao (u „es tut mir leid“)","note":"Samo u „Es tut mir leid“ („žao mi je“), doslovno „to mi čini tugu“."},{"lemma":"de:gern","gloss":"rado","note":"„Gern geschehen“ je doslovno „rado se desilo“: uobičajen odgovor na „danke“."},{"lemma":"de:geschehen","gloss":"desiti se"},{"lemma":"de:gut","gloss":"dobar"},{"lemma":"de:abend","gloss":"veče"},{"lemma":"de:auf","gloss":"na"},{"lemma":"de:wiedersehen","gloss":"ponovni susret"},{"lemma":"de:verstehen","gloss":"razumeti"},{"lemma":"de:nicht","gloss":"ne"},{"lemma":"de:sprechen","gloss":"govoriti"},{"lemma":"de:sie","gloss":"Vi (učtivo); ona; oni","note":"Napisano velikim slovom, „Sie“ je učtivo „Vi“, za jednu osobu ili više njih, u razgovoru sa nepoznatima."},{"lemma":"de:langsam","gloss":"polako"},{"lemma":"de:konnen","gloss":"moći"},{"lemma":"de:der","gloss":"(određeni član)","note":"Der (muški), die (ženski), das (srednji), die (množina). „Den“ je muški oblik posle glagola kao što su „nehmen“ i „haben“."},{"lemma":"de:wiederholen","gloss":"ponoviti"},{"lemma":"de:was","gloss":"šta"},{"lemma":"de:bedeuten","gloss":"značiti"},{"lemma":"de:wissen","gloss":"znati"},{"lemma":"de:danke","gloss":"hvala"},{"lemma":"de:viel","gloss":"mnogo"},{"lemma":"de:dank","gloss":"hvala"}]}
