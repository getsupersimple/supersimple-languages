{"schema_version":1,"course":"tourist-de","unit":"emergencies-and-health","language":"sr","target_language":"de","phrases":[{"concept":"help","text":{"Latn":"Upomoć!","Cyrl":"Упомоћ!"}},{"concept":"call-the-police","text":{"Latn":"Pozovite policiju!","Cyrl":"Позовите полицију!"}},{"concept":"call-an-ambulance","text":{"Latn":"Pozovite hitnu pomoć!","Cyrl":"Позовите хитну помоћ!"}},{"concept":"i-need-a-doctor","text":{"Latn":"Treba mi lekar","Cyrl":"Треба ми лекар"}},{"concept":"where-is-the-pharmacy","text":{"Latn":"Gde je apoteka?","Cyrl":"Где је апотека?"}},{"concept":"where-is-the-hospital","text":{"Latn":"Gde je bolnica?","Cyrl":"Где је болница?"}},{"concept":"i-feel-sick","text":{"Latn":"Pozlilo mi je","Cyrl":"Позлило ми је"}},{"concept":"please-help-me","text":{"Latn":"Pomozite mi, molim","Cyrl":"Помозите ми, молим"}},{"concept":"stop-thief","text":{"Latn":"Lopov!","Cyrl":"Лопов!"}},{"concept":"it-hurts-here","text":{"Latn":"Boli me ovde","Cyrl":"Боли ме овде"}}],"glosses":[{"lemma":"de:hilfe","gloss":"pomoć"},{"lemma":"de:rufen","gloss":"pozvati"},{"lemma":"de:sie","gloss":"Vi (učtivo); ona; oni","note":"Napisano velikim slovom, „Sie“ je učtivo „Vi“, za jednu osobu ili više njih, u razgovoru sa nepoznatima."},{"lemma":"de:der","gloss":"(određeni član)","note":"Der (muški), die (ženski), das (srednji), die (množina). „Den“ je muški oblik posle glagola kao što su „nehmen“ i „haben“."},{"lemma":"de:polizei","gloss":"policija"},{"lemma":"de:ein","gloss":"(neodređeni član); jedan","note":"Ein (muški, srednji), eine (ženski); „einen“ je muški oblik za ono što tražite ili uzimate."},{"lemma":"de:krankenwagen","gloss":"hitna pomoć"},{"lemma":"de:ich","gloss":"ja","note":"„Mir“ je oblik posle glagola kao što je „helfen“: „Helfen Sie mir“."},{"lemma":"de:brauchen","gloss":"trebati"},{"lemma":"de:arzt","gloss":"lekar"},{"lemma":"de:wo","gloss":"gde"},{"lemma":"de:sein","gloss":"biti"},{"lemma":"de:apotheke","gloss":"apoteka"},{"lemma":"de:krankenhaus","gloss":"bolnica"},{"lemma":"de:schlecht","gloss":"loše; muka","note":"„Mir ist schlecht“ znači „muka mi je“."},{"lemma":"de:helfen","gloss":"pomoći"},{"lemma":"de:bitte","gloss":"molim","note":"Znači „molim“, a takođe i „nema na čemu“ kao odgovor na „danke“."},{"lemma":"de:halt","gloss":"stani!"},{"lemma":"de:dieb","gloss":"lopov"},{"lemma":"de:hier","gloss":"ovde"},{"lemma":"de:wehtun","gloss":"boleti","note":"Rastavljiv glagol: „Hier tut es weh“ znači „Ovde boli“."},{"lemma":"de:es","gloss":"ono"}]}
