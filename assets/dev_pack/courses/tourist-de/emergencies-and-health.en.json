{"schema_version":1,"course":"tourist-de","unit":"emergencies-and-health","language":"en","target_language":"de","phrases":[{"concept":"help","text":{"Latn":"Help!"}},{"concept":"call-the-police","text":{"Latn":"Call the police!"}},{"concept":"call-an-ambulance","text":{"Latn":"Call an ambulance!"}},{"concept":"i-need-a-doctor","text":{"Latn":"I need a doctor"}},{"concept":"where-is-the-pharmacy","text":{"Latn":"Where is the pharmacy?"}},{"concept":"where-is-the-hospital","text":{"Latn":"Where is the hospital?"}},{"concept":"i-feel-sick","text":{"Latn":"I feel sick"}},{"concept":"please-help-me","text":{"Latn":"Please help me"}},{"concept":"stop-thief","text":{"Latn":"Stop, thief!"}},{"concept":"it-hurts-here","text":{"Latn":"It hurts here"}}],"glosses":[{"lemma":"de:hilfe","gloss":"help"},{"lemma":"de:rufen","gloss":"to call"},{"lemma":"de:sie","gloss":"you (formal); she; they","note":"Written with a capital, “Sie” is the polite “you” for one person or several, used with strangers."},{"lemma":"de:der","gloss":"the","note":"Der (masculine), die (feminine), das (neuter), die (plural). “Den” is the masculine form after verbs like “nehmen” or “haben”."},{"lemma":"de:polizei","gloss":"police"},{"lemma":"de:ein","gloss":"a, an; one","note":"Ein (masculine, neuter), eine (feminine); “einen” is the masculine form for the thing you ask for or take."},{"lemma":"de:krankenwagen","gloss":"ambulance"},{"lemma":"de:ich","gloss":"I","note":"“Mir” is the form used after verbs like “helfen”: “Helfen Sie mir.”"},{"lemma":"de:brauchen","gloss":"to need"},{"lemma":"de:arzt","gloss":"doctor"},{"lemma":"de:wo","gloss":"where"},{"lemma":"de:sein","gloss":"to be"},{"lemma":"de:apotheke","gloss":"pharmacy"},{"lemma":"de:krankenhaus","gloss":"hospital"},{"lemma":"de:schlecht","gloss":"bad; sick (of nausea)","note":"“Mir ist schlecht” means “I feel sick”, in the sense of nausea."},{"lemma":"de:helfen","gloss":"to help"},{"lemma":"de:bitte","gloss":"please","note":"Means “please”, and also “you’re welcome” in reply to “danke”."},{"lemma":"de:halt","gloss":"stop!"},{"lemma":"de:dieb","gloss":"thief"},{"lemma":"de:hier","gloss":"here"},{"lemma":"de:wehtun","gloss":"to hurt","note":"A separable verb: “Hier tut es weh” is “It hurts here.”"},{"lemma":"de:es","gloss":"it"}]}
