{"schema_version":1,"course":"tourist-fr","unit":"food-and-getting-around","language":"sr","target_language":"fr","phrases":[{"concept":"one-coffee-please","text":{"Latn":"Jednu kafu, molim","Cyrl":"Једну кафу, молим"}},{"concept":"where-is-the-bathroom","text":{"Latn":"Gde je toalet?","Cyrl":"Где је тоалет?"}}],"glosses":[{"lemma":"fr:un","gloss":"jedan","note":"Un (muški rod), une (ženski rod)."},{"lemma":"fr:cafe","gloss":"kafa","note":"Znači i kafić. Samo „un café“ je obično mala, jaka crna kafa."},{"lemma":"fr:si","gloss":"ako","note":"Ispred „il“ postaje s': s'il."},{"lemma":"fr:vous","gloss":"vi","note":"Uljudno i množinsko „vi“; „tu“ je neformalno „ti“."},{"lemma":"fr:plaire","gloss":"dopadati se, prijati","note":"„S'il vous plaît“ doslovno znači „ako vam se sviđa“ i koristi se kao „molim“."},{"lemma":"fr:ou","gloss":"gde","note":"Sa akcentom (où) znači „gde“; bez akcenta (ou) znači „ili“."},{"lemma":"fr:etre","gloss":"biti"},{"lemma":"fr:le","gloss":"određeni član","note":"Le (muški rod), la (ženski rod), les (množina). Srpski nema članove."},{"lemma":"fr:toilettes","gloss":"toalet","note":"Na francuskom se uvek koristi u množini."}]}
