{"schema_version":1,"course":"tourist-fr","unit":"greetings-and-basics","language":"en","target_language":"fr","phrases":[{"concept":"good-day","text":{"Latn":"Good day"}},{"concept":"thank-you","text":{"Latn":"Thank you"}},{"concept":"do-you-speak-english","text":{"Latn":"Do you speak English?"}},{"concept":"i-am-tired","text":{"Latn":"I'm tired"}},{"concept":"how-are-you","text":{"Latn":"How are you?"}},{"concept":"fine-thanks","text":{"Latn":"I'm fine, thank you"}},{"concept":"what-is-your-name","text":{"Latn":"What is your name?"}},{"concept":"where-are-you-from","text":{"Latn":"Where are you from?"}},{"concept":"good-night","text":{"Latn":"Good night"}},{"concept":"have-a-nice-day","text":{"Latn":"Have a nice day"}}],"glosses":[{"lemma":"fr:bonjour","gloss":"hello, good day","note":"Used all day; \"bonsoir\" takes over in the evening."},{"lemma":"fr:merci","gloss":"thank you"},{"lemma":"fr:parler","gloss":"to speak"},{"lemma":"fr:vous","gloss":"you","note":"The polite and the plural \"you\"; \"tu\" is the informal singular."},{"lemma":"fr:anglais","gloss":"English","note":"A noun when it names the language, always masculine and lowercase: \"parler anglais\" is \"to speak English\"."},{"lemma":"fr:je","gloss":"I","note":"Becomes j' before a vowel."},{"lemma":"fr:etre","gloss":"to be"},{"lemma":"fr:fatigue","gloss":"tired","note":"Fatigué (masculine) and fatiguée (feminine) are written differently but sound the same."},{"lemma":"fr:comment","gloss":"how"},{"lemma":"fr:aller","gloss":"to go"},{"lemma":"fr:bien","gloss":"well"},{"lemma":"fr:appeler","gloss":"to call"},{"lemma":"fr:d-ou","gloss":"from where"},{"lemma":"fr:venir","gloss":"to come"},{"lemma":"fr:bon","gloss":"good"},{"lemma":"fr:nuit","gloss":"night"},{"lemma":"fr:journee","gloss":"day (the whole day)"}]}
