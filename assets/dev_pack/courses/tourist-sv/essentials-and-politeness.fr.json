{"schema_version":1,"course":"tourist-sv","unit":"essentials-and-politeness","language":"fr","target_language":"sv","phrases":[{"concept":"yes","text":{"Latn":"Oui"}},{"concept":"no","text":{"Latn":"Non"}},{"concept":"please","text":{"Latn":"S'il vous plaît"}},{"concept":"excuse-me","text":{"Latn":"Excusez-moi"}},{"concept":"sorry","text":{"Latn":"Pardon"}},{"concept":"youre-welcome","text":{"Latn":"De rien"}},{"concept":"good-evening","text":{"Latn":"Bonsoir"}},{"concept":"goodbye","text":{"Latn":"Au revoir"}},{"concept":"i-dont-understand","text":{"Latn":"Je ne comprends pas"}},{"concept":"speak-slowly-please","text":{"Latn":"Parlez lentement, s'il vous plaît"}},{"concept":"can-you-repeat","text":{"Latn":"Pouvez-vous répéter ?"}},{"concept":"i-understand","text":{"Latn":"Je comprends"}},{"concept":"what-does-this-mean","text":{"Latn":"Que signifie ça ?"}},{"concept":"i-dont-know","text":{"Latn":"Je ne sais pas"}},{"concept":"no-thank-you","text":{"Latn":"Non, merci"}},{"concept":"thank-you-very-much","text":{"Latn":"Merci beaucoup"}}],"glosses":[{"lemma":"sv:ja","gloss":"oui"},{"lemma":"sv:nej","gloss":"non"},{"lemma":"sv:snall","gloss":"gentil(le) ; « snälla » = s'il te plaît","note":"« Snälla » s'emploie seul comme un « s'il te plaît » appuyé."},{"lemma":"sv:ursakta","gloss":"excuser","note":"« Ursäkta » sert à attirer l'attention ou à passer devant quelqu'un."},{"lemma":"sv:forlat","gloss":"pardon, désolé"},{"lemma":"sv:ingen","gloss":"aucun, pas de","note":"« Ingen orsak » veut littéralement dire « aucune raison » : la réponse habituelle à « tack »."},{"lemma":"sv:orsak","gloss":"raison, cause"},{"lemma":"sv:god","gloss":"bon","note":"« God » va avec les mots en (God dag, God kväll) ; les mots ett prennent « gott ». « Gott ! » seul veut dire « Délicieux ! »."},{"lemma":"sv:kvall","gloss":"soir"},{"lemma":"sv:hej","gloss":"salut, bonjour"},{"lemma":"sv:da","gloss":"alors ; « hej då » = au revoir"},{"lemma":"sv:jag","gloss":"je","note":"« Mig » est la forme complément : « Hjälp mig » (aidez-moi)."},{"lemma":"sv:forsta","gloss":"comprendre"},{"lemma":"sv:inte","gloss":"ne … pas","note":"Il se place après le verbe : « Jag förstår inte. »"},{"lemma":"sv:tala","gloss":"parler"},{"lemma":"sv:langsamt","gloss":"lentement"},{"lemma":"sv:tack","gloss":"merci ; s'il vous plaît","note":"Veut dire « merci », et après une demande aussi « s'il vous plaît » : « En kaffe, tack. »"},{"lemma":"sv:kunna","gloss":"pouvoir"},{"lemma":"sv:du","gloss":"tu","note":"Les Suédois disent « du » à presque tout le monde, inconnus et chefs compris. « Ni » sert pour plusieurs personnes ou, rarement, par grande politesse."},{"lemma":"sv:upprepa","gloss":"répéter"},{"lemma":"sv:det","gloss":"il, ce, cela"},{"lemma":"sv:vad","gloss":"quoi, que"},{"lemma":"sv:betyda","gloss":"signifier"},{"lemma":"sv:har","gloss":"ici","note":"« Det här » veut dire « ceci », littéralement « le ici »."},{"lemma":"sv:veta","gloss":"savoir"},{"lemma":"sv:sa","gloss":"si, tellement"},{"lemma":"sv:mycket","gloss":"beaucoup"}]}
