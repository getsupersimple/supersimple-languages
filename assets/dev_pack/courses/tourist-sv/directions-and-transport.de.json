{"schema_version":1,"course":"tourist-sv","unit":"directions-and-transport","language":"de","target_language":"sv","phrases":[{"concept":"where-is-the-station","text":{"Latn":"Wo ist der Bahnhof?"}},{"concept":"where-is-the-bus-stop","text":{"Latn":"Wo ist die Bushaltestelle?"}},{"concept":"a-ticket-please","text":{"Latn":"Eine Fahrkarte, bitte"}},{"concept":"how-do-i-get-to-the-centre","text":{"Latn":"Wie komme ich ins Zentrum?"}},{"concept":"is-it-far","text":{"Latn":"Ist es weit?"}},{"concept":"turn-left","text":{"Latn":"Biegen Sie links ab"}},{"concept":"turn-right","text":{"Latn":"Biegen Sie rechts ab"}},{"concept":"go-straight","text":{"Latn":"Gehen Sie geradeaus"}},{"concept":"call-a-taxi","text":{"Latn":"Rufen Sie bitte ein Taxi"}},{"concept":"where-is-the-exit","text":{"Latn":"Wo ist der Ausgang?"}},{"concept":"where-is-the-bathroom","text":{"Latn":"Wo ist die Toilette?"}},{"concept":"where-is-the-airport","text":{"Latn":"Wo ist der Flughafen?"}},{"concept":"i-dont-know-where-i-am","text":{"Latn":"Ich weiß nicht, wo ich bin"}},{"concept":"stop-here-please","text":{"Latn":"Halten Sie hier, bitte"}},{"concept":"how-long-does-it-take","text":{"Latn":"Wie lange dauert das?"}},{"concept":"where-can-i-buy-a-ticket","text":{"Latn":"Wo kann ich eine Fahrkarte kaufen?"}},{"concept":"is-it-near","text":{"Latn":"Ist es in der Nähe?"}}],"glosses":[{"lemma":"sv:var","gloss":"wo"},{"lemma":"sv:vara","gloss":"sein","note":"„Är“ ist die Gegenwartsform für alle Personen: jag är, du är, det är."},{"lemma":"sv:tagstation","gloss":"Bahnhof","note":"Ein Kompositum: „tåg“ (Zug) + „station“. Schwedisch schreibt Wörter zusammen."},{"lemma":"sv:busshallplats","gloss":"Bushaltestelle","note":"Ein Kompositum: „buss“ + „hållplats“ (Haltepunkt)."},{"lemma":"sv:en","gloss":"ein, eine","note":"Schwedisch hat zwei Genera: „en“ für die meisten Wörter (en kaffe) und „ett“ für die übrigen (ett glas). Lern jedes Nomen mit seinem Artikel."},{"lemma":"sv:biljett","gloss":"Fahrkarte"},{"lemma":"sv:tack","gloss":"danke; bitte","note":"Heißt „danke“, nach einer Bitte auch „bitte“: „En kaffe, tack.“"},{"lemma":"sv:hur","gloss":"wie"},{"lemma":"sv:ta","gloss":"nehmen","note":"„Hur tar jag mig till…?“ heißt wörtlich „wie nehme ich mich zu…?“, die übliche Frage nach dem Weg."},{"lemma":"sv:jag","gloss":"ich","note":"„Mig“ ist die Objektform: „Hjälp mig“ (hilf mir)."},{"lemma":"sv:till","gloss":"zu, nach"},{"lemma":"sv:centrum","gloss":"Zentrum"},{"lemma":"sv:det","gloss":"es, das"},{"lemma":"sv:lang","gloss":"lang; weit","note":"„Långt“ heißt auch „weit“ (Är det långt?)."},{"lemma":"sv:svanga","gloss":"abbiegen"},{"lemma":"sv:vanster","gloss":"links"},{"lemma":"sv:hoger","gloss":"rechts"},{"lemma":"sv:ga","gloss":"gehen"},{"lemma":"sv:rakt","gloss":"gerade"},{"lemma":"sv:fram","gloss":"vorwärts, voraus","note":"„Rakt fram“ heißt „geradeaus“."},{"lemma":"sv:ringa","gloss":"anrufen, rufen"},{"lemma":"sv:taxi","gloss":"Taxi"},{"lemma":"sv:utgang","gloss":"Ausgang"},{"lemma":"sv:toalett","gloss":"Toilette","note":"Die Endung „-en“ bedeutet „der/die“: toaletten ist „die Toilette“."},{"lemma":"sv:flygplats","gloss":"Flughafen"},{"lemma":"sv:veta","gloss":"wissen"},{"lemma":"sv:inte","gloss":"nicht","note":"Es steht nach dem Verb: „Jag förstår inte.“"},{"lemma":"sv:stanna","gloss":"halten"},{"lemma":"sv:har","gloss":"hier","note":"„Det här“ heißt „dies“, wörtlich „das hier“."},{"lemma":"sv:tid","gloss":"Zeit"},{"lemma":"sv:kunna","gloss":"können"},{"lemma":"sv:kopa","gloss":"kaufen"},{"lemma":"sv:nara","gloss":"nah"}]}
