{"schema_version":1,"course":"tourist-sv","unit":"food-and-drink","language":"sr","target_language":"sv","phrases":[{"concept":"one-coffee-please","text":{"Latn":"Jednu kafu, molim","Cyrl":"Једну кафу, молим"}},{"concept":"water-please","text":{"Latn":"Čašu vode, molim","Cyrl":"Чашу воде, молим"}},{"concept":"table-for-two","text":{"Latn":"Sto za dvoje, molim","Cyrl":"Сто за двоје, молим"}},{"concept":"the-menu-please","text":{"Latn":"Jelovnik, molim","Cyrl":"Јеловник, молим"}},{"concept":"the-bill-please","text":{"Latn":"Račun, molim","Cyrl":"Рачун, молим"}},{"concept":"i-dont-eat-meat","text":{"Latn":"Ne jedem meso","Cyrl":"Не једем месо"}},{"concept":"without-nuts-please","text":{"Latn":"Bez oraha, molim","Cyrl":"Без ораха, молим"}},{"concept":"what-do-you-recommend","text":{"Latn":"Šta preporučujete?","Cyrl":"Шта препоручујете?"}},{"concept":"delicious","text":{"Latn":"Ukusno!","Cyrl":"Укусно!"}},{"concept":"a-beer-please","text":{"Latn":"Jedno pivo, molim","Cyrl":"Једно пиво, молим"}},{"concept":"cheers","text":{"Latn":"Živeli!","Cyrl":"Живели!"}}],"glosses":[{"lemma":"sv:en","gloss":"jedan; neki","note":"Švedski ima dva roda: „en“ za većinu reči (en kaffe) i „ett“ za ostale (ett glas). Svaku imenicu učite sa članom."},{"lemma":"sv:kaffe","gloss":"kafa"},{"lemma":"sv:tack","gloss":"hvala; molim","note":"Znači „hvala“, a posle molbe i „molim“: „En kaffe, tack.“"},{"lemma":"sv:glas","gloss":"čaša","note":"„Ett glas vatten“ je „čaša vode“: u švedskom nema reči za „od“."},{"lemma":"sv:vatten","gloss":"voda"},{"lemma":"sv:bord","gloss":"sto"},{"lemma":"sv:for","gloss":"za"},{"lemma":"sv:tva","gloss":"dva"},{"lemma":"sv:meny","gloss":"jelovnik"},{"lemma":"sv:nota","gloss":"račun"},{"lemma":"sv:jag","gloss":"ja","note":"„Mig“ je oblik za objekat: „Hjälp mig“ (pomozite mi)."},{"lemma":"sv:ata","gloss":"jesti"},{"lemma":"sv:inte","gloss":"ne","note":"Dolazi posle glagola: „Jag förstår inte.“"},{"lemma":"sv:kott","gloss":"meso"},{"lemma":"sv:utan","gloss":"bez"},{"lemma":"sv:not","gloss":"orah"},{"lemma":"sv:vad","gloss":"šta"},{"lemma":"sv:rekommendera","gloss":"preporučiti"},{"lemma":"sv:du","gloss":"ti","note":"Šveđani kažu „du“ gotovo svima, i strancima i šefovima. „Ni“ je za više osoba ili, retko, za veoma formalno obraćanje."},{"lemma":"sv:god","gloss":"dobar","note":"„God“ ide uz reči roda „en“ (God dag, God kväll), a uz reči roda „ett“ ide „gott“. Samo „Gott!“ znači „Ukusno!“."},{"lemma":"sv:ol","gloss":"pivo"},{"lemma":"sv:skal","gloss":"živeli!","note":"Doslovno „činija“; zdravica je „Skål!“."}]}
