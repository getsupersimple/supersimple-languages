{"schema_version":1,"course":"tourist-sv","unit":"emergencies-and-health","language":"de","target_language":"sv","phrases":[{"concept":"help","text":{"Latn":"Hilfe!"}},{"concept":"call-the-police","text":{"Latn":"Rufen Sie die Polizei!"}},{"concept":"call-an-ambulance","text":{"Latn":"Rufen Sie einen Krankenwagen!"}},{"concept":"i-need-a-doctor","text":{"Latn":"Ich brauche einen Arzt"}},{"concept":"where-is-the-pharmacy","text":{"Latn":"Wo ist die Apotheke?"}},{"concept":"where-is-the-hospital","text":{"Latn":"Wo ist das Krankenhaus?"}},{"concept":"i-feel-sick","text":{"Latn":"Mir ist schlecht"}},{"concept":"please-help-me","text":{"Latn":"Helfen Sie mir, bitte"}},{"concept":"stop-thief","text":{"Latn":"Halt, Dieb!"}},{"concept":"it-hurts-here","text":{"Latn":"Hier tut es weh"}}],"glosses":[{"lemma":"sv:hjalp","gloss":"Hilfe"},{"lemma":"sv:ringa","gloss":"anrufen, rufen"},{"lemma":"sv:polis","gloss":"Polizei","note":"„Polisen“ („die Polizei“) bekommt die Endung „-en“. „Polis“ allein ist ein Polizist."},{"lemma":"sv:en","gloss":"ein, eine","note":"Schwedisch hat zwei Genera: „en“ für die meisten Wörter (en kaffe) und „ett“ für die übrigen (ett glas). Lern jedes Nomen mit seinem Artikel."},{"lemma":"sv:ambulans","gloss":"Krankenwagen"},{"lemma":"sv:jag","gloss":"ich","note":"„Mig“ ist die Objektform: „Hjälp mig“ (hilf mir)."},{"lemma":"sv:behova","gloss":"brauchen"},{"lemma":"sv:lakare","gloss":"Arzt, Ärztin"},{"lemma":"sv:var","gloss":"wo"},{"lemma":"sv:vara","gloss":"sein","note":"„Är“ ist die Gegenwartsform für alle Personen: jag är, du är, det är."},{"lemma":"sv:apotek","gloss":"Apotheke"},{"lemma":"sv:sjukhus","gloss":"Krankenhaus"},{"lemma":"sv:maa","gloss":"sich fühlen","note":"„Jag mår illa“ heißt „mir ist übel“; „Jag mår bra“ heißt „mir geht es gut“."},{"lemma":"sv:illa","gloss":"schlecht, übel"},{"lemma":"sv:hjalpa","gloss":"helfen"},{"lemma":"sv:tack","gloss":"danke; bitte","note":"Heißt „danke“, nach einer Bitte auch „bitte“: „En kaffe, tack.“"},{"lemma":"sv:stoppa","gloss":"anhalten, aufhalten"},{"lemma":"sv:tjuv","gloss":"Dieb"},{"lemma":"sv:det","gloss":"es, das"},{"lemma":"sv:gora","gloss":"tun, machen","note":"„Det gör ont“ (es tut weh) heißt wörtlich „es macht Schmerz“."},{"lemma":"sv:ont","gloss":"Schmerz, Weh"},{"lemma":"sv:har","gloss":"hier","note":"„Det här“ heißt „dies“, wörtlich „das hier“."}]}
