{"schema_version":1,"course":"tourist-sv","unit":"essentials-and-politeness","language":"en","target_language":"sv","phrases":[{"concept":"yes","text":{"Latn":"Yes"}},{"concept":"no","text":{"Latn":"No"}},{"concept":"please","text":{"Latn":"Please"}},{"concept":"excuse-me","text":{"Latn":"Excuse me"}},{"concept":"sorry","text":{"Latn":"I'm sorry"}},{"concept":"youre-welcome","text":{"Latn":"You're welcome"}},{"concept":"good-evening","text":{"Latn":"Good evening"}},{"concept":"goodbye","text":{"Latn":"Goodbye"}},{"concept":"i-dont-understand","text":{"Latn":"I don't understand"}},{"concept":"speak-slowly-please","text":{"Latn":"Please speak slowly"}},{"concept":"can-you-repeat","text":{"Latn":"Can you repeat that?"}},{"concept":"i-understand","text":{"Latn":"I understand"}},{"concept":"what-does-this-mean","text":{"Latn":"What does this mean?"}},{"concept":"i-dont-know","text":{"Latn":"I don't know"}},{"concept":"no-thank-you","text":{"Latn":"No, thank you"}},{"concept":"thank-you-very-much","text":{"Latn":"Thank you very much"}}],"glosses":[{"lemma":"sv:ja","gloss":"yes"},{"lemma":"sv:nej","gloss":"no"},{"lemma":"sv:snall","gloss":"kind; “snälla” = please","note":"“Snälla” works on its own as a heartfelt “please”."},{"lemma":"sv:ursakta","gloss":"to excuse","note":"“Ursäkta” is the everyday way to get attention or squeeze past."},{"lemma":"sv:forlat","gloss":"sorry; forgive me"},{"lemma":"sv:ingen","gloss":"no, not any","note":"“Ingen orsak” is literally “no reason”: the usual reply to “tack”."},{"lemma":"sv:orsak","gloss":"reason, cause"},{"lemma":"sv:god","gloss":"good","note":"“God” goes with en-words (God dag, God kväll); ett-words take “gott”. “Gott!” on its own means “Tasty!”."},{"lemma":"sv:kvall","gloss":"evening"},{"lemma":"sv:hej","gloss":"hello, hi"},{"lemma":"sv:da","gloss":"then; “hej då” = goodbye"},{"lemma":"sv:jag","gloss":"I","note":"“Mig” is the object form: “Hjälp mig” (help me)."},{"lemma":"sv:forsta","gloss":"to understand"},{"lemma":"sv:inte","gloss":"not","note":"It comes after the verb: “Jag förstår inte.”"},{"lemma":"sv:tala","gloss":"to speak"},{"lemma":"sv:langsamt","gloss":"slowly"},{"lemma":"sv:tack","gloss":"thank you; please","note":"Means “thank you”, and after a request also “please”: “En kaffe, tack.”"},{"lemma":"sv:kunna","gloss":"can, to be able to"},{"lemma":"sv:du","gloss":"you (informal, singular)","note":"Swedes say “du” to almost everyone, strangers and bosses included. “Ni” is for several people or, rarely, very formal."},{"lemma":"sv:upprepa","gloss":"to repeat"},{"lemma":"sv:det","gloss":"it, that"},{"lemma":"sv:vad","gloss":"what"},{"lemma":"sv:betyda","gloss":"to mean"},{"lemma":"sv:har","gloss":"here","note":"“Det här” is “this”, literally “the here”."},{"lemma":"sv:veta","gloss":"to know"},{"lemma":"sv:sa","gloss":"so"},{"lemma":"sv:mycket","gloss":"much, a lot"}]}
