{"schema_version":1,"course":"tourist-sv","unit":"directions-and-transport","language":"sr","target_language":"sv","phrases":[{"concept":"where-is-the-station","text":{"Latn":"Gde je železnička stanica?","Cyrl":"Где је железничка станица?"}},{"concept":"where-is-the-bus-stop","text":{"Latn":"Gde je autobuska stanica?","Cyrl":"Где је аутобуска станица?"}},{"concept":"a-ticket-please","text":{"Latn":"Jednu kartu, molim","Cyrl":"Једну карту, молим"}},{"concept":"how-do-i-get-to-the-centre","text":{"Latn":"Kako da stignem do centra?","Cyrl":"Како да стигнем до центра?"}},{"concept":"is-it-far","text":{"Latn":"Je li daleko?","Cyrl":"Је ли далеко?"}},{"concept":"turn-left","text":{"Latn":"Skrenite levo","Cyrl":"Скрените лево"}},{"concept":"turn-right","text":{"Latn":"Skrenite desno","Cyrl":"Скрените десно"}},{"concept":"go-straight","text":{"Latn":"Idite pravo","Cyrl":"Идите право"}},{"concept":"call-a-taxi","text":{"Latn":"Pozovite taksi, molim","Cyrl":"Позовите такси, молим"}},{"concept":"where-is-the-exit","text":{"Latn":"Gde je izlaz?","Cyrl":"Где је излаз?"}},{"concept":"where-is-the-bathroom","text":{"Latn":"Gde je toalet?","Cyrl":"Где је тоалет?"}},{"concept":"where-is-the-airport","text":{"Latn":"Gde je aerodrom?","Cyrl":"Где је аеродром?"}},{"concept":"i-dont-know-where-i-am","text":{"Latn":"Ne znam gde sam","Cyrl":"Не знам где сам"}},{"concept":"stop-here-please","text":{"Latn":"Stanite ovde, molim","Cyrl":"Станите овде, молим"}},{"concept":"how-long-does-it-take","text":{"Latn":"Koliko dugo traje?","Cyrl":"Колико дуго траје?"}},{"concept":"where-can-i-buy-a-ticket","text":{"Latn":"Gde mogu da kupim kartu?","Cyrl":"Где могу да купим карту?"}},{"concept":"is-it-near","text":{"Latn":"Je li blizu?","Cyrl":"Је ли близу?"}}],"glosses":[{"lemma":"sv:var","gloss":"gde"},{"lemma":"sv:vara","gloss":"biti","note":"„Är“ je prezent za sva lica: jag är, du är, det är."},{"lemma":"sv:tagstation","gloss":"železnička stanica","note":"Složenica: „tåg“ (voz) + „station“. Švedski spaja reči u jednu."},{"lemma":"sv:busshallplats","gloss":"autobusko stajalište","note":"Složenica: „buss“ + „hållplats“ (mesto zaustavljanja)."},{"lemma":"sv:en","gloss":"jedan; neki","note":"Švedski ima dva roda: „en“ za većinu reči (en kaffe) i „ett“ za ostale (ett glas). Svaku imenicu učite sa članom."},{"lemma":"sv:biljett","gloss":"karta"},{"lemma":"sv:tack","gloss":"hvala; molim","note":"Znači „hvala“, a posle molbe i „molim“: „En kaffe, tack.“"},{"lemma":"sv:hur","gloss":"kako"},{"lemma":"sv:ta","gloss":"uzeti","note":"„Hur tar jag mig till…?“ doslovno je „kako se uzimam do…?“, uobičajeno pitanje za put."},{"lemma":"sv:jag","gloss":"ja","note":"„Mig“ je oblik za objekat: „Hjälp mig“ (pomozite mi)."},{"lemma":"sv:till","gloss":"do, ka"},{"lemma":"sv:centrum","gloss":"centar"},{"lemma":"sv:det","gloss":"to, ono"},{"lemma":"sv:lang","gloss":"dug; daleko","note":"„Långt“ znači i „daleko“ (Är det långt?)."},{"lemma":"sv:svanga","gloss":"skrenuti"},{"lemma":"sv:vanster","gloss":"levo"},{"lemma":"sv:hoger","gloss":"desno"},{"lemma":"sv:ga","gloss":"ići, hodati"},{"lemma":"sv:rakt","gloss":"pravo"},{"lemma":"sv:fram","gloss":"napred","note":"„Rakt fram“ znači „pravo napred“."},{"lemma":"sv:ringa","gloss":"pozvati, telefonirati"},{"lemma":"sv:taxi","gloss":"taksi"},{"lemma":"sv:utgang","gloss":"izlaz"},{"lemma":"sv:toalett","gloss":"toalet","note":"Nastavak „-en“ znači „taj/ta“: toaletten je „toalet“ sa određenim članom."},{"lemma":"sv:flygplats","gloss":"aerodrom"},{"lemma":"sv:veta","gloss":"znati"},{"lemma":"sv:inte","gloss":"ne","note":"Dolazi posle glagola: „Jag förstår inte.“"},{"lemma":"sv:stanna","gloss":"stati"},{"lemma":"sv:har","gloss":"ovde","note":"„Det här“ znači „ovo“, doslovno „to ovde“."},{"lemma":"sv:tid","gloss":"vreme"},{"lemma":"sv:kunna","gloss":"moći"},{"lemma":"sv:kopa","gloss":"kupiti"},{"lemma":"sv:nara","gloss":"blizu"}]}
