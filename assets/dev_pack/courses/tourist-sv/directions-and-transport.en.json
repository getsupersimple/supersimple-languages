{"schema_version":1,"course":"tourist-sv","unit":"directions-and-transport","language":"en","target_language":"sv","phrases":[{"concept":"where-is-the-station","text":{"Latn":"Where is the train station?"}},{"concept":"where-is-the-bus-stop","text":{"Latn":"Where is the bus stop?"}},{"concept":"a-ticket-please","text":{"Latn":"A ticket, please"}},{"concept":"how-do-i-get-to-the-centre","text":{"Latn":"How do I get to the centre?"}},{"concept":"is-it-far","text":{"Latn":"Is it far?"}},{"concept":"turn-left","text":{"Latn":"Turn left"}},{"concept":"turn-right","text":{"Latn":"Turn right"}},{"concept":"go-straight","text":{"Latn":"Go straight ahead"}},{"concept":"call-a-taxi","text":{"Latn":"Please call a taxi"}},{"concept":"where-is-the-exit","text":{"Latn":"Where is the exit?"}},{"concept":"where-is-the-bathroom","text":{"Latn":"Where is the bathroom?"}},{"concept":"where-is-the-airport","text":{"Latn":"Where is the airport?"}},{"concept":"i-dont-know-where-i-am","text":{"Latn":"I don't know where I am"}},{"concept":"stop-here-please","text":{"Latn":"Stop here, please"}},{"concept":"how-long-does-it-take","text":{"Latn":"How long does it take?"}},{"concept":"where-can-i-buy-a-ticket","text":{"Latn":"Where can I buy a ticket?"}},{"concept":"is-it-near","text":{"Latn":"Is it nearby?"}}],"glosses":[{"lemma":"sv:var","gloss":"where"},{"lemma":"sv:vara","gloss":"to be","note":"“Är” is the present tense for every person: jag är, du är, det är."},{"lemma":"sv:tagstation","gloss":"train station","note":"A compound: “tåg” (train) + “station”. Swedish glues words together."},{"lemma":"sv:busshallplats","gloss":"bus stop","note":"A compound: “buss” + “hållplats” (stopping place)."},{"lemma":"sv:en","gloss":"a, an; one","note":"Swedish has two genders: “en” for most words (en kaffe) and “ett” for the rest (ett glas). Learn each noun with its article."},{"lemma":"sv:biljett","gloss":"ticket"},{"lemma":"sv:tack","gloss":"thank you; please","note":"Means “thank you”, and after a request also “please”: “En kaffe, tack.”"},{"lemma":"sv:hur","gloss":"how"},{"lemma":"sv:ta","gloss":"to take","note":"“Hur tar jag mig till…?” is literally “how take I myself to…?”, the usual way to ask the way."},{"lemma":"sv:jag","gloss":"I","note":"“Mig” is the object form: “Hjälp mig” (help me)."},{"lemma":"sv:till","gloss":"to"},{"lemma":"sv:centrum","gloss":"centre"},{"lemma":"sv:det","gloss":"it, that"},{"lemma":"sv:lang","gloss":"long; far","note":"“Långt” is also the word for “far” (Är det långt?)."},{"lemma":"sv:svanga","gloss":"to turn"},{"lemma":"sv:vanster","gloss":"left"},{"lemma":"sv:hoger","gloss":"right"},{"lemma":"sv:ga","gloss":"to go, to walk"},{"lemma":"sv:rakt","gloss":"straight"},{"lemma":"sv:fram","gloss":"forward, ahead","note":"“Rakt fram” is “straight ahead”."},{"lemma":"sv:ringa","gloss":"to call, to phone"},{"lemma":"sv:taxi","gloss":"taxi"},{"lemma":"sv:utgang","gloss":"exit"},{"lemma":"sv:toalett","gloss":"toilet, bathroom","note":"The ending “-en” means “the”: toaletten is “the toilet”."},{"lemma":"sv:flygplats","gloss":"airport"},{"lemma":"sv:veta","gloss":"to know"},{"lemma":"sv:inte","gloss":"not","note":"It comes after the verb: “Jag förstår inte.”"},{"lemma":"sv:stanna","gloss":"to stop"},{"lemma":"sv:har","gloss":"here","note":"“Det här” is “this”, literally “the here”."},{"lemma":"sv:tid","gloss":"time"},{"lemma":"sv:kunna","gloss":"can, to be able to"},{"lemma":"sv:kopa","gloss":"to buy"},{"lemma":"sv:nara","gloss":"nearby"}]}
