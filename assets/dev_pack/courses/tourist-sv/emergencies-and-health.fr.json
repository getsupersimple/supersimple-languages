{"schema_version":1,"course":"tourist-sv","unit":"emergencies-and-health","language":"fr","target_language":"sv","phrases":[{"concept":"help","text":{"Latn":"Au secours !"}},{"concept":"call-the-police","text":{"Latn":"Appelez la police !"}},{"concept":"call-an-ambulance","text":{"Latn":"Appelez une ambulance !"}},{"concept":"i-need-a-doctor","text":{"Latn":"Il me faut un médecin"}},{"concept":"where-is-the-pharmacy","text":{"Latn":"Où est la pharmacie ?"}},{"concept":"where-is-the-hospital","text":{"Latn":"Où est l'hôpital ?"}},{"concept":"i-feel-sick","text":{"Latn":"Je me sens mal"}},{"concept":"please-help-me","text":{"Latn":"Aidez-moi, s'il vous plaît"}},{"concept":"stop-thief","text":{"Latn":"Au voleur !"}},{"concept":"it-hurts-here","text":{"Latn":"J'ai mal ici"}}],"glosses":[{"lemma":"sv:hjalp","gloss":"aide, secours"},{"lemma":"sv:ringa","gloss":"appeler, téléphoner"},{"lemma":"sv:polis","gloss":"police","note":"« Polisen » (« la police ») prend la terminaison « -en ». « Polis » seul désigne un policier."},{"lemma":"sv:en","gloss":"un, une","note":"Le suédois a deux genres : « en » pour la plupart des mots (en kaffe) et « ett » pour les autres (ett glas). Apprenez chaque nom avec son article."},{"lemma":"sv:ambulans","gloss":"ambulance"},{"lemma":"sv:jag","gloss":"je","note":"« Mig » est la forme complément : « Hjälp mig » (aidez-moi)."},{"lemma":"sv:behova","gloss":"avoir besoin de"},{"lemma":"sv:lakare","gloss":"médecin"},{"lemma":"sv:var","gloss":"où"},{"lemma":"sv:vara","gloss":"être","note":"« Är » est le présent pour toutes les personnes : jag är, du är, det är."},{"lemma":"sv:apotek","gloss":"pharmacie"},{"lemma":"sv:sjukhus","gloss":"hôpital"},{"lemma":"sv:maa","gloss":"se sentir","note":"« Jag mår illa » veut dire « J'ai la nausée » ; « Jag mår bra » : « Je vais bien »."},{"lemma":"sv:illa","gloss":"mal"},{"lemma":"sv:hjalpa","gloss":"aider"},{"lemma":"sv:tack","gloss":"merci ; s'il vous plaît","note":"Veut dire « merci », et après une demande aussi « s'il vous plaît » : « En kaffe, tack. »"},{"lemma":"sv:stoppa","gloss":"arrêter"},{"lemma":"sv:tjuv","gloss":"voleur"},{"lemma":"sv:det","gloss":"il, ce, cela"},{"lemma":"sv:gora","gloss":"faire","note":"« Det gör ont » (ça fait mal) : littéralement « ça fait mal »."},{"lemma":"sv:ont","gloss":"mal, douleur"},{"lemma":"sv:har","gloss":"ici","note":"« Det här » veut dire « ceci », littéralement « le ici »."}]}
