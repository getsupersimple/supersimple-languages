{"schema_version":1,"course":"tourist-sv","unit":"accommodation-and-shopping","language":"de","target_language":"sv","phrases":[{"concept":"i-have-a-reservation","text":{"Latn":"Ich habe eine Reservierung"}},{"concept":"how-much-is-this","text":{"Latn":"Was kostet das?"}},{"concept":"too-expensive","text":{"Latn":"Das ist zu teuer"}},{"concept":"do-you-take-cards","text":{"Latn":"Akzeptieren Sie Karten?"}},{"concept":"where-is-the-atm","text":{"Latn":"Wo ist der Geldautomat?"}},{"concept":"do-you-have-a-free-room","text":{"Latn":"Haben Sie ein freies Zimmer?"}},{"concept":"the-key-please","text":{"Latn":"Den Schlüssel, bitte"}},{"concept":"what-time-do-you-open","text":{"Latn":"Wann öffnen Sie?"}},{"concept":"can-i-have-a-receipt","text":{"Latn":"Kann ich eine Quittung bekommen?"}},{"concept":"ill-take-it","text":{"Latn":"Ich nehme es"}}],"glosses":[{"lemma":"sv:jag","gloss":"ich","note":"„Mig“ ist die Objektform: „Hjälp mig“ (hilf mir)."},{"lemma":"sv:ha","gloss":"haben"},{"lemma":"sv:en","gloss":"ein, eine","note":"Schwedisch hat zwei Genera: „en“ für die meisten Wörter (en kaffe) und „ett“ für die übrigen (ett glas). Lern jedes Nomen mit seinem Artikel."},{"lemma":"sv:bokning","gloss":"Reservierung, Buchung"},{"lemma":"sv:vad","gloss":"was"},{"lemma":"sv:kosta","gloss":"kosten"},{"lemma":"sv:det","gloss":"es, das"},{"lemma":"sv:har","gloss":"hier","note":"„Det här“ heißt „dies“, wörtlich „das hier“."},{"lemma":"sv:vara","gloss":"sein","note":"„Är“ ist die Gegenwartsform für alle Personen: jag är, du är, det är."},{"lemma":"sv:for-2","gloss":"zu (übermäßig)","note":"Dasselbe Wort wie die Präposition „för“; vor einem Adjektiv heißt es „zu“."},{"lemma":"sv:dyr","gloss":"teuer"},{"lemma":"sv:ta","gloss":"nehmen","note":"„Hur tar jag mig till…?“ heißt wörtlich „wie nehme ich mich zu…?“, die übliche Frage nach dem Weg."},{"lemma":"sv:ni","gloss":"ihr; Sie","note":"Verwendet man bei Personal in Läden und Hotels; „du“ geht auch."},{"lemma":"sv:emot","gloss":"(in „ta emot“) annehmen","note":"„Ta emot“ ist ein Partikelverb: „Tar ni emot kort?“ heißt „Akzeptieren Sie Karten?“"},{"lemma":"sv:kort","gloss":"Karte"},{"lemma":"sv:var","gloss":"wo"},{"lemma":"sv:finnas","gloss":"es geben; sich befinden","note":"„Var finns…?“ fragt, wo etwas ist, wörtlich „wo gibt es…?“."},{"lemma":"sv:bankomat","gloss":"Geldautomat"},{"lemma":"sv:ledig","gloss":"frei"},{"lemma":"sv:rum","gloss":"Zimmer"},{"lemma":"sv:nyckel","gloss":"Schlüssel"},{"lemma":"sv:tack","gloss":"danke; bitte","note":"Heißt „danke“, nach einer Bitte auch „bitte“: „En kaffe, tack.“"},{"lemma":"sv:nar","gloss":"wann"},{"lemma":"sv:oppna","gloss":"öffnen"},{"lemma":"sv:kunna","gloss":"können"},{"lemma":"sv:fa","gloss":"bekommen, dürfen","note":"„Kan jag få…?“ ist die höfliche Art, um etwas zu bitten."},{"lemma":"sv:kvitto","gloss":"Quittung"}]}
