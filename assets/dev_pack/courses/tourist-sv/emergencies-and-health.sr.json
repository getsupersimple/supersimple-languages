{"schema_version":1,"course":"tourist-sv","unit":"emergencies-and-health","language":"sr","target_language":"sv","phrases":[{"concept":"help","text":{"Latn":"Upomoć!","Cyrl":"Упомоћ!"}},{"concept":"call-the-police","text":{"Latn":"Pozovite policiju!","Cyrl":"Позовите полицију!"}},{"concept":"call-an-ambulance","text":{"Latn":"Pozovite hitnu pomoć!","Cyrl":"Позовите хитну помоћ!"}},{"concept":"i-need-a-doctor","text":{"Latn":"Treba mi lekar","Cyrl":"Треба ми лекар"}},{"concept":"where-is-the-pharmacy","text":{"Latn":"Gde je apoteka?","Cyrl":"Где је апотека?"}},{"concept":"where-is-the-hospital","text":{"Latn":"Gde je bolnica?","Cyrl":"Где је болница?"}},{"concept":"i-feel-sick","text":{"Latn":"Pozlilo mi je","Cyrl":"Позлило ми је"}},{"concept":"please-help-me","text":{"Latn":"Pomozite mi, molim","Cyrl":"Помозите ми, молим"}},{"concept":"stop-thief","text":{"Latn":"Lopov!","Cyrl":"Лопов!"}},{"concept":"it-hurts-here","text":{"Latn":"Boli me ovde","Cyrl":"Боли ме овде"}}],"glosses":[{"lemma":"sv:hjalp","gloss":"pomoć"},{"lemma":"sv:ringa","gloss":"pozvati, telefonirati"},{"lemma":"sv:polis","gloss":"policija","note":"„Polisen“ („policija“) dobija nastavak „-en“. „Polis“ samo znači policajac."},{"lemma":"sv:en","gloss":"jedan; neki","note":"Švedski ima dva roda: „en“ za većinu reči (en kaffe) i „ett“ za ostale (ett glas). Svaku imenicu učite sa članom."},{"lemma":"sv:ambulans","gloss":"hitna pomoć"},{"lemma":"sv:jag","gloss":"ja","note":"„Mig“ je oblik za objekat: „Hjälp mig“ (pomozite mi)."},{"lemma":"sv:behova","gloss":"trebati"},{"lemma":"sv:lakare","gloss":"lekar"},{"lemma":"sv:var","gloss":"gde"},{"lemma":"sv:vara","gloss":"biti","note":"„Är“ je prezent za sva lica: jag är, du är, det är."},{"lemma":"sv:apotek","gloss":"apoteka"},{"lemma":"sv:sjukhus","gloss":"bolnica"},{"lemma":"sv:maa","gloss":"osećati se","note":"„Jag mår illa“ znači „muka mi je“; „Jag mår bra“ znači „dobro sam“."},{"lemma":"sv:illa","gloss":"loše"},{"lemma":"sv:hjalpa","gloss":"pomoći"},{"lemma":"sv:tack","gloss":"hvala; molim","note":"Znači „hvala“, a posle molbe i „molim“: „En kaffe, tack.“"},{"lemma":"sv:stoppa","gloss":"zaustaviti"},{"lemma":"sv:tjuv","gloss":"lopov"},{"lemma":"sv:det","gloss":"to, ono"},{"lemma":"sv:gora","gloss":"raditi, činiti","note":"„Det gör ont“ (boli) je doslovno „to čini bol“."},{"lemma":"sv:ont","gloss":"bol"},{"lemma":"sv:har","gloss":"ovde","note":"„Det här“ znači „ovo“, doslovno „to ovde“."}]}
