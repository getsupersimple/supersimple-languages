{"schema_version":1,"course":"tourist-sv","unit":"essentials-and-politeness","language":"sr","target_language":"sv","phrases":[{"concept":"yes","text":{"Latn":"Da","Cyrl":"Да"}},{"concept":"no","text":{"Latn":"Ne","Cyrl":"Не"}},{"concept":"please","text":{"Latn":"Molim","Cyrl":"Молим"}},{"concept":"excuse-me","text":{"Latn":"Izvinite","Cyrl":"Извините"}},{"concept":"sorry","text":{"Latn":"Žao mi je","Cyrl":"Жао ми је"}},{"concept":"youre-welcome","text":{"Latn":"Nema na čemu","Cyrl":"Нема на чему"}},{"concept":"good-evening","text":{"Latn":"Dobro veče","Cyrl":"Добро вече"}},{"concept":"goodbye","text":{"Latn":"Doviđenja","Cyrl":"Довиђења"}},{"concept":"i-dont-understand","text":{"Latn":"Ne razumem","Cyrl":"Не разумем"}},{"concept":"speak-slowly-please","text":{"Latn":"Govorite polako, molim","Cyrl":"Говорите полако, молим"}},{"concept":"can-you-repeat","text":{"Latn":"Možete li da ponovite?","Cyrl":"Можете ли да поновите?"}},{"concept":"i-understand","text":{"Latn":"Razumem","Cyrl":"Разумем"}},{"concept":"what-does-this-mean","text":{"Latn":"Šta ovo znači?","Cyrl":"Шта ово значи?"}},{"concept":"i-dont-know","text":{"Latn":"Ne znam","Cyrl":"Не знам"}},{"concept":"no-thank-you","text":{"Latn":"Ne, hvala","Cyrl":"Не, хвала"}},{"concept":"thank-you-very-much","text":{"Latn":"Mnogo hvala","Cyrl":"Много хвала"}}],"glosses":[{"lemma":"sv:ja","gloss":"da"},{"lemma":"sv:nej","gloss":"ne"},{"lemma":"sv:snall","gloss":"ljubazan; „snälla“ = molim","note":"„Snälla“ se može reći samo kao usrdno „molim“."},{"lemma":"sv:ursakta","gloss":"izviniti","note":"„Ursäkta“ se kaže da privučete pažnju ili da prođete."},{"lemma":"sv:forlat","gloss":"izvini, oprosti"},{"lemma":"sv:ingen","gloss":"nikakav","note":"„Ingen orsak“ doslovno znači „nema razloga“: uobičajen odgovor na „tack“."},{"lemma":"sv:orsak","gloss":"razlog, uzrok"},{"lemma":"sv:god","gloss":"dobar","note":"„God“ ide uz reči roda „en“ (God dag, God kväll), a uz reči roda „ett“ ide „gott“. Samo „Gott!“ znači „Ukusno!“."},{"lemma":"sv:kvall","gloss":"veče"},{"lemma":"sv:hej","gloss":"zdravo"},{"lemma":"sv:da","gloss":"tada; „hej då“ = doviđenja"},{"lemma":"sv:jag","gloss":"ja","note":"„Mig“ je oblik za objekat: „Hjälp mig“ (pomozite mi)."},{"lemma":"sv:forsta","gloss":"razumeti"},{"lemma":"sv:inte","gloss":"ne","note":"Dolazi posle glagola: „Jag förstår inte.“"},{"lemma":"sv:tala","gloss":"govoriti"},{"lemma":"sv:langsamt","gloss":"polako"},{"lemma":"sv:tack","gloss":"hvala; molim","note":"Znači „hvala“, a posle molbe i „molim“: „En kaffe, tack.“"},{"lemma":"sv:kunna","gloss":"moći"},{"lemma":"sv:du","gloss":"ti","note":"Šveđani kažu „du“ gotovo svima, i strancima i šefovima. „Ni“ je za više osoba ili, retko, za veoma formalno obraćanje."},{"lemma":"sv:upprepa","gloss":"ponoviti"},{"lemma":"sv:det","gloss":"to, ono"},{"lemma":"sv:vad","gloss":"šta"},{"lemma":"sv:betyda","gloss":"značiti"},{"lemma":"sv:har","gloss":"ovde","note":"„Det här“ znači „ovo“, doslovno „to ovde“."},{"lemma":"sv:veta","gloss":"znati"},{"lemma":"sv:sa","gloss":"tako"},{"lemma":"sv:mycket","gloss":"mnogo"}]}
