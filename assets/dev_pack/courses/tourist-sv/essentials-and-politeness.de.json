{"schema_version":1,"course":"tourist-sv","unit":"essentials-and-politeness","language":"de","target_language":"sv","phrases":[{"concept":"yes","text":{"Latn":"Ja"}},{"concept":"no","text":{"Latn":"Nein"}},{"concept":"please","text":{"Latn":"Bitte"}},{"concept":"excuse-me","text":{"Latn":"Entschuldigung"}},{"concept":"sorry","text":{"Latn":"Es tut mir leid"}},{"concept":"youre-welcome","text":{"Latn":"Gern geschehen"}},{"concept":"good-evening","text":{"Latn":"Guten Abend"}},{"concept":"goodbye","text":{"Latn":"Auf Wiedersehen"}},{"concept":"i-dont-understand","text":{"Latn":"Ich verstehe nicht"}},{"concept":"speak-slowly-please","text":{"Latn":"Sprechen Sie bitte langsam"}},{"concept":"can-you-repeat","text":{"Latn":"Können Sie das wiederholen?"}},{"concept":"i-understand","text":{"Latn":"Ich verstehe"}},{"concept":"what-does-this-mean","text":{"Latn":"Was bedeutet das?"}},{"concept":"i-dont-know","text":{"Latn":"Ich weiß es nicht"}},{"concept":"no-thank-you","text":{"Latn":"Nein, danke"}},{"concept":"thank-you-very-much","text":{"Latn":"Vielen Dank"}}],"glosses":[{"lemma":"sv:ja","gloss":"ja"},{"lemma":"sv:nej","gloss":"nein"},{"lemma":"sv:snall","gloss":"nett; „snälla“ = bitte","note":"„Snälla“ allein ist ein eindringliches „bitte“."},{"lemma":"sv:ursakta","gloss":"entschuldigen","note":"„Ursäkta“ sagt man, um Aufmerksamkeit zu bekommen oder sich vorbeizudrängen."},{"lemma":"sv:forlat","gloss":"Verzeihung, Entschuldigung"},{"lemma":"sv:ingen","gloss":"kein, keine","note":"„Ingen orsak“ heißt wörtlich „kein Grund“: die übliche Antwort auf „tack“."},{"lemma":"sv:orsak","gloss":"Grund, Ursache"},{"lemma":"sv:god","gloss":"gut","note":"„God“ steht bei en-Wörtern (God dag, God kväll), ett-Wörter haben „gott“. „Gott!“ allein heißt „Lecker!“."},{"lemma":"sv:kvall","gloss":"Abend"},{"lemma":"sv:hej","gloss":"hallo"},{"lemma":"sv:da","gloss":"dann; „hej då“ = auf Wiedersehen"},{"lemma":"sv:jag","gloss":"ich","note":"„Mig“ ist die Objektform: „Hjälp mig“ (hilf mir)."},{"lemma":"sv:forsta","gloss":"verstehen"},{"lemma":"sv:inte","gloss":"nicht","note":"Es steht nach dem Verb: „Jag förstår inte.“"},{"lemma":"sv:tala","gloss":"sprechen"},{"lemma":"sv:langsamt","gloss":"langsam"},{"lemma":"sv:tack","gloss":"danke; bitte","note":"Heißt „danke“, nach einer Bitte auch „bitte“: „En kaffe, tack.“"},{"lemma":"sv:kunna","gloss":"können"},{"lemma":"sv:du","gloss":"du","note":"Schweden sagen „du“ fast zu jedem, auch zu Fremden und Chefs. „Ni“ gilt für mehrere Personen oder, selten, sehr förmlich."},{"lemma":"sv:upprepa","gloss":"wiederholen"},{"lemma":"sv:det","gloss":"es, das"},{"lemma":"sv:vad","gloss":"was"},{"lemma":"sv:betyda","gloss":"bedeuten"},{"lemma":"sv:har","gloss":"hier","note":"„Det här“ heißt „dies“, wörtlich „das hier“."},{"lemma":"sv:veta","gloss":"wissen"},{"lemma":"sv:sa","gloss":"so"},{"lemma":"sv:mycket","gloss":"viel"}]}
