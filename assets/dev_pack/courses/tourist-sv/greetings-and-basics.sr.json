{"schema_version":1,"course":"tourist-sv","unit":"greetings-and-basics","language":"sr","target_language":"sv","phrases":[{"concept":"good-day","text":{"Latn":"Dobar dan","Cyrl":"Добар дан"}},{"concept":"thank-you","text":{"Latn":"Hvala","Cyrl":"Хвала"}},{"concept":"do-you-speak-english","text":{"Latn":"Govorite li engleski?","Cyrl":"Говорите ли енглески?"}},{"concept":"i-am-tired","variant":"m","text":{"Latn":"Umoran sam","Cyrl":"Уморан сам"}},{"concept":"i-am-tired","variant":"f","text":{"Latn":"Umorna sam","Cyrl":"Уморна сам"}},{"concept":"how-are-you","text":{"Latn":"Kako ste?","Cyrl":"Како сте?"}},{"concept":"fine-thanks","text":{"Latn":"Dobro sam, hvala","Cyrl":"Добро сам, хвала"}},{"concept":"what-is-your-name","text":{"Latn":"Kako se zovete?","Cyrl":"Како се зовете?"}},{"concept":"where-are-you-from","text":{"Latn":"Odakle ste?","Cyrl":"Одакле сте?"}},{"concept":"good-night","text":{"Latn":"Laku noć","Cyrl":"Лаку ноћ"}},{"concept":"have-a-nice-day","text":{"Latn":"Prijatan dan","Cyrl":"Пријатан дан"}}],"glosses":[{"lemma":"sv:god","gloss":"dobar","note":"„God“ ide uz reči roda „en“ (God dag, God kväll), a uz reči roda „ett“ ide „gott“. Samo „Gott!“ znači „Ukusno!“."},{"lemma":"sv:dag","gloss":"dan"},{"lemma":"sv:tack","gloss":"hvala; molim","note":"Znači „hvala“, a posle molbe i „molim“: „En kaffe, tack.“"},{"lemma":"sv:tala","gloss":"govoriti"},{"lemma":"sv:du","gloss":"ti","note":"Šveđani kažu „du“ gotovo svima, i strancima i šefovima. „Ni“ je za više osoba ili, retko, za veoma formalno obraćanje."},{"lemma":"sv:engelska","gloss":"engleski (jezik)","note":"Na švedskom se imena jezika pišu malim slovom."},{"lemma":"sv:jag","gloss":"ja","note":"„Mig“ je oblik za objekat: „Hjälp mig“ (pomozite mi)."},{"lemma":"sv:vara","gloss":"biti","note":"„Är“ je prezent za sva lica: jag är, du är, det är."},{"lemma":"sv:trott","gloss":"umoran","note":"Isto za muškarce i žene."},{"lemma":"sv:hur","gloss":"kako"},{"lemma":"sv:maa","gloss":"osećati se","note":"„Jag mår illa“ znači „muka mi je“; „Jag mår bra“ znači „dobro sam“."},{"lemma":"sv:bra","gloss":"dobro, u redu"},{"lemma":"sv:vad","gloss":"šta"},{"lemma":"sv:heta","gloss":"zvati (se)"},{"lemma":"sv:varifran","gloss":"odakle"},{"lemma":"sv:komma","gloss":"doći"},{"lemma":"sv:natt","gloss":"noć"},{"lemma":"sv:ha","gloss":"imati"},{"lemma":"sv:en","gloss":"jedan; neki","note":"Švedski ima dva roda: „en“ za većinu reči (en kaffe) i „ett“ za ostale (ett glas). Svaku imenicu učite sa članom."}]}
