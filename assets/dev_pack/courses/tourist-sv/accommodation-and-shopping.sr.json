{"schema_version":1,"course":"tourist-sv","unit":"accommodation-and-shopping","language":"sr","target_language":"sv","phrases":[{"concept":"i-have-a-reservation","text":{"Latn":"Imam rezervaciju","Cyrl":"Имам резервацију"}},{"concept":"how-much-is-this","text":{"Latn":"Koliko ovo košta?","Cyrl":"Колико ово кошта?"}},{"concept":"too-expensive","text":{"Latn":"Preskupo je","Cyrl":"Прескупо је"}},{"concept":"do-you-take-cards","text":{"Latn":"Primate li kartice?","Cyrl":"Примате ли картице?"}},{"concept":"where-is-the-atm","text":{"Latn":"Gde je bankomat?","Cyrl":"Где је банкомат?"}},{"concept":"do-you-have-a-free-room","text":{"Latn":"Imate li slobodnu sobu?","Cyrl":"Имате ли слободну собу?"}},{"concept":"the-key-please","text":{"Latn":"Ključ, molim","Cyrl":"Кључ, молим"}},{"concept":"what-time-do-you-open","text":{"Latn":"Kada otvarate?","Cyrl":"Када отварате?"}},{"concept":"can-i-have-a-receipt","text":{"Latn":"Mogu li dobiti račun?","Cyrl":"Могу ли добити рачун?"}},{"concept":"ill-take-it","text":{"Latn":"Uzeću to","Cyrl":"Узећу то"}}],"glosses":[{"lemma":"sv:jag","gloss":"ja","note":"„Mig“ je oblik za objekat: „Hjälp mig“ (pomozite mi)."},{"lemma":"sv:ha","gloss":"imati"},{"lemma":"sv:en","gloss":"jedan; neki","note":"Švedski ima dva roda: „en“ za većinu reči (en kaffe) i „ett“ za ostale (ett glas). Svaku imenicu učite sa članom."},{"lemma":"sv:bokning","gloss":"rezervacija"},{"lemma":"sv:vad","gloss":"šta"},{"lemma":"sv:kosta","gloss":"koštati"},{"lemma":"sv:det","gloss":"to, ono"},{"lemma":"sv:har","gloss":"ovde","note":"„Det här“ znači „ovo“, doslovno „to ovde“."},{"lemma":"sv:vara","gloss":"biti","note":"„Är“ je prezent za sva lica: jag är, du är, det är."},{"lemma":"sv:for-2","gloss":"previše","note":"Ista reč kao predlog „för“; ispred pridleva znači „previše“."},{"lemma":"sv:dyr","gloss":"skup"},{"lemma":"sv:ta","gloss":"uzeti","note":"„Hur tar jag mig till…?“ doslovno je „kako se uzimam do…?“, uobičajeno pitanje za put."},{"lemma":"sv:ni","gloss":"vi (množina ili uljudno)","note":"Koristi se sa osobljem u prodavnicama i hotelima; „du“ je takođe u redu."},{"lemma":"sv:emot","gloss":"(u „ta emot“) primiti","note":"„Ta emot“ je glagol sa česticom: „Tar ni emot kort?“ je „Primate li kartice?“"},{"lemma":"sv:kort","gloss":"kartica"},{"lemma":"sv:var","gloss":"gde"},{"lemma":"sv:finnas","gloss":"postojati; nalaziti se","note":"„Var finns…?“ pita gde se nešto nalazi, doslovno „gde ima…?“."},{"lemma":"sv:bankomat","gloss":"bankomat"},{"lemma":"sv:ledig","gloss":"slobodan"},{"lemma":"sv:rum","gloss":"soba"},{"lemma":"sv:nyckel","gloss":"ključ"},{"lemma":"sv:tack","gloss":"hvala; molim","note":"Znači „hvala“, a posle molbe i „molim“: „En kaffe, tack.“"},{"lemma":"sv:nar","gloss":"kada"},{"lemma":"sv:oppna","gloss":"otvoriti"},{"lemma":"sv:kunna","gloss":"moći"},{"lemma":"sv:fa","gloss":"dobiti","note":"„Kan jag få…?“ je učtiv način da se nešto zatraži."},{"lemma":"sv:kvitto","gloss":"priznanica"}]}
