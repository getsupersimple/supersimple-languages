{"schema_version":1,"course":"tourist-en","unit":"emergencies-and-health","language":"fr","target_language":"en","phrases":[{"concept":"help","text":{"Latn":"Au secours !"}},{"concept":"call-the-police","text":{"Latn":"Appelez la police !"}},{"concept":"call-an-ambulance","text":{"Latn":"Appelez une ambulance !"}},{"concept":"i-need-a-doctor","text":{"Latn":"Il me faut un médecin"}},{"concept":"where-is-the-pharmacy","text":{"Latn":"Où est la pharmacie ?"}},{"concept":"where-is-the-hospital","text":{"Latn":"Où est l'hôpital ?"}},{"concept":"i-feel-sick","text":{"Latn":"Je me sens mal"}},{"concept":"please-help-me","text":{"Latn":"Aidez-moi, s'il vous plaît"}},{"concept":"stop-thief","text":{"Latn":"Au voleur !"}},{"concept":"it-hurts-here","text":{"Latn":"J'ai mal ici"}}],"glosses":[{"lemma":"en:help","gloss":"aider, au secours","note":"Seul, « Help! » est un appel au secours."},{"lemma":"en:call","gloss":"appeler"},{"lemma":"en:the","gloss":"le, la, les (article défini)","note":"Invariable : un seul mot pour le, la et les."},{"lemma":"en:police","gloss":"police","note":"Toujours singulier et précédé de « the »."},{"lemma":"en:a","gloss":"un, une (article indéfini)","note":"Devient « an » devant une voyelle : an ambulance."},{"lemma":"en:ambulance","gloss":"ambulance"},{"lemma":"en:i","gloss":"je, moi","note":"S'écrit toujours avec une majuscule. « me » est sa forme complément."},{"lemma":"en:need","gloss":"avoir besoin de"},{"lemma":"en:doctor","gloss":"médecin"},{"lemma":"en:where","gloss":"où"},{"lemma":"en:be","gloss":"être","note":"Souvent contracté : I'm = I am, you're = you are, that's = that is."},{"lemma":"en:pharmacy","gloss":"pharmacie","note":"Au Royaume-Uni on dit aussi « chemist's »."},{"lemma":"en:hospital","gloss":"hôpital"},{"lemma":"en:feel","gloss":"se sentir"},{"lemma":"en:sick","gloss":"malade","note":"Au Royaume-Uni « sick » veut aussi dire « avoir envie de vomir »."},{"lemma":"en:please","gloss":"s'il vous plaît, s'il te plaît","note":"Se place au début ou à la fin de la phrase."},{"lemma":"en:stop","gloss":"arrêter, s'arrêter"},{"lemma":"en:thief","gloss":"voleur"},{"lemma":"en:it","gloss":"il, elle, ce, cela"},{"lemma":"en:hurt","gloss":"faire mal"},{"lemma":"en:here","gloss":"ici"}]}
