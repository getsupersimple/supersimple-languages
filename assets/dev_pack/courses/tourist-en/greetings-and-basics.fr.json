{"schema_version":1,"course":"tourist-en","unit":"greetings-and-basics","language":"fr","target_language":"en","phrases":[{"concept":"good-day","text":{"Latn":"Bonjour"}},{"concept":"thank-you","text":{"Latn":"Merci"}},{"concept":"do-you-speak-english","text":{"Latn":"Parlez-vous anglais ?"}},{"concept":"i-am-tired","variant":"m","text":{"Latn":"Je suis fatigué"}},{"concept":"i-am-tired","variant":"f","text":{"Latn":"Je suis fatiguée"}},{"concept":"how-are-you","text":{"Latn":"Comment allez-vous ?"}},{"concept":"fine-thanks","text":{"Latn":"Je vais bien, merci"}},{"concept":"what-is-your-name","text":{"Latn":"Comment vous appelez-vous ?"}},{"concept":"where-are-you-from","text":{"Latn":"D'où venez-vous ?"}},{"concept":"good-night","text":{"Latn":"Bonne nuit"}},{"concept":"have-a-nice-day","text":{"Latn":"Bonne journée"}}],"glosses":[{"lemma":"en:good","gloss":"bon"},{"lemma":"en:day","gloss":"jour"},{"lemma":"en:thank","gloss":"remercier","note":"« Thank you » veut dire « merci » ; « thanks » est la version familière."},{"lemma":"en:you","gloss":"tu, vous","note":"L'anglais n'a qu'un seul mot pour le tutoiement et le vouvoiement, au singulier comme au pluriel."},{"lemma":"en:do","gloss":"faire (auxiliaire)","note":"Sert à former les questions et les négations (« Do you…? », « I don't… ») ; il ne se traduit pas."},{"lemma":"en:speak","gloss":"parler"},{"lemma":"en:english","gloss":"anglais","note":"Prend toujours une majuscule en anglais, langue comme nationalité."},{"lemma":"en:be","gloss":"être","note":"Souvent contracté : I'm = I am, you're = you are, that's = that is."},{"lemma":"en:tired","gloss":"fatigué(e)","note":"L'adjectif ne change pas selon le genre de la personne qui parle."},{"lemma":"en:how","gloss":"comment"},{"lemma":"en:fine","gloss":"bien, en forme"},{"lemma":"en:what","gloss":"quoi, que, quel"},{"lemma":"en:your","gloss":"votre, ton"},{"lemma":"en:name","gloss":"nom"},{"lemma":"en:where","gloss":"où"},{"lemma":"en:from","gloss":"de"},{"lemma":"en:night","gloss":"nuit"},{"lemma":"en:have","gloss":"avoir"},{"lemma":"en:a","gloss":"un, une (article indéfini)","note":"Devient « an » devant une voyelle : an ambulance."},{"lemma":"en:nice","gloss":"agréable"}]}
