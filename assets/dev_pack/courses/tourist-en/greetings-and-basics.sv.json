{"schema_version":1,"course":"tourist-en","unit":"greetings-and-basics","language":"sv","target_language":"en","phrases":[{"concept":"good-day","text":{"Latn":"God dag"}},{"concept":"thank-you","text":{"Latn":"Tack"}},{"concept":"do-you-speak-english","text":{"Latn":"Talar du engelska?"}},{"concept":"i-am-tired","text":{"Latn":"Jag är trött"}},{"concept":"how-are-you","text":{"Latn":"Hur mår du?"}},{"concept":"fine-thanks","text":{"Latn":"Bra, tack"}},{"concept":"what-is-your-name","text":{"Latn":"Vad heter du?"}},{"concept":"where-are-you-from","text":{"Latn":"Varifrån kommer du?"}},{"concept":"good-night","text":{"Latn":"God natt"}},{"concept":"have-a-nice-day","text":{"Latn":"Ha en bra dag"}}],"glosses":[{"lemma":"en:good","gloss":"bra, god"},{"lemma":"en:day","gloss":"dag"},{"lemma":"en:thank","gloss":"tacka","note":"„Thank you“ är „tack“; „thanks“ är den vardagliga varianten."},{"lemma":"en:you","gloss":"du, ni","note":"Engelskan har bara ett „you“, ingen skillnad mellan „du“ och „ni“."},{"lemma":"en:do","gloss":"göra (hjälpverb)","note":"Bildar frågor och nekanden („Do you…?“, „I don't…“); översätts inte."},{"lemma":"en:speak","gloss":"tala"},{"lemma":"en:english","gloss":"engelska (språket)","note":"Skrivs alltid med stor bokstav, både som språk och som nationalitet."},{"lemma":"en:be","gloss":"vara","note":"Ofta förkortat: I'm = I am, you're = you are, that's = that is."},{"lemma":"en:tired","gloss":"trött","note":"Adjektivet ändras inte efter talarens kön."},{"lemma":"en:how","gloss":"hur"},{"lemma":"en:fine","gloss":"bra, fin"},{"lemma":"en:what","gloss":"vad"},{"lemma":"en:your","gloss":"din, er"},{"lemma":"en:name","gloss":"namn"},{"lemma":"en:where","gloss":"var"},{"lemma":"en:from","gloss":"från"},{"lemma":"en:night","gloss":"natt"},{"lemma":"en:have","gloss":"ha"},{"lemma":"en:a","gloss":"en, ett (obestämd artikel)","note":"Blir „an“ framför en vokal: an ambulance. Engelskan skiljer inte mellan en och ett."},{"lemma":"en:nice","gloss":"trevlig"}]}
