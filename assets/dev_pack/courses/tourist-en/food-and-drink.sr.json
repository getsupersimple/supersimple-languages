{"schema_version":1,"course":"tourist-en","unit":"food-and-drink","language":"sr","target_language":"en","phrases":[{"concept":"one-coffee-please","text":{"Latn":"Jednu kafu, molim","Cyrl":"Једну кафу, молим"}},{"concept":"water-please","text":{"Latn":"Čašu vode, molim","Cyrl":"Чашу воде, молим"}},{"concept":"table-for-two","text":{"Latn":"Sto za dvoje, molim","Cyrl":"Сто за двоје, молим"}},{"concept":"the-menu-please","text":{"Latn":"Jelovnik, molim","Cyrl":"Јеловник, молим"}},{"concept":"the-bill-please","text":{"Latn":"Račun, molim","Cyrl":"Рачун, молим"}},{"concept":"i-dont-eat-meat","text":{"Latn":"Ne jedem meso","Cyrl":"Не једем месо"}},{"concept":"without-nuts-please","text":{"Latn":"Bez oraha, molim","Cyrl":"Без ораха, молим"}},{"concept":"what-do-you-recommend","text":{"Latn":"Šta preporučujete?","Cyrl":"Шта препоручујете?"}},{"concept":"delicious","text":{"Latn":"Ukusno!","Cyrl":"Укусно!"}},{"concept":"a-beer-please","text":{"Latn":"Jedno pivo, molim","Cyrl":"Једно пиво, молим"}},{"concept":"cheers","text":{"Latn":"Živeli!","Cyrl":"Живели!"}}],"glosses":[{"lemma":"en:one","gloss":"jedan"},{"lemma":"en:coffee","gloss":"kafa"},{"lemma":"en:please","gloss":"molim","note":"Stavlja se na početak ili na kraj rečenice."},{"lemma":"en:a","gloss":"(neodređeni član)","note":"Pred samoglasnikom postaje „an“: an ambulance. Srpski nema članove."},{"lemma":"en:glass","gloss":"čaša"},{"lemma":"en:of","gloss":"od, (genitiv)","note":"„A glass of water“ je „čaša vode“: engleskom „of“ odgovara srpski genitiv."},{"lemma":"en:water","gloss":"voda"},{"lemma":"en:table","gloss":"sto"},{"lemma":"en:for","gloss":"za"},{"lemma":"en:two","gloss":"dva"},{"lemma":"en:the","gloss":"(određeni član)","note":"Ne menja se: jedna reč za sve rodove i brojeve. Srpski nema članove."},{"lemma":"en:menu","gloss":"jelovnik"},{"lemma":"en:bill","gloss":"račun","note":"U Velikoj Britaniji je to račun u restoranu; Amerikanci kažu „check“."},{"lemma":"en:i","gloss":"ja","note":"Uvek se piše velikim slovom. „me“ je oblik za objekat."},{"lemma":"en:do","gloss":"raditi (pomoćni glagol)","note":"Služi za građenje pitanja i odricanja („Do you…?“, „I don't…“); ne prevodi se."},{"lemma":"en:eat","gloss":"jesti"},{"lemma":"en:meat","gloss":"meso"},{"lemma":"en:without","gloss":"bez"},{"lemma":"en:nut","gloss":"orah, orašasti plod"},{"lemma":"en:what","gloss":"šta, koji"},{"lemma":"en:you","gloss":"ti, vi","note":"Engleski ima jednu reč za „ti“ i „vi“, i za jedninu i za množinu."},{"lemma":"en:recommend","gloss":"preporučiti"},{"lemma":"en:delicious","gloss":"ukusan"},{"lemma":"en:beer","gloss":"pivo"},{"lemma":"en:cheers","gloss":"živeli!","note":"Neformalno se koristi i kao „hvala“."}]}
