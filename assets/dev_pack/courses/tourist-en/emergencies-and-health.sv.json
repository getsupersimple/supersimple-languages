{"schema_version":1,"course":"tourist-en","unit":"emergencies-and-health","language":"sv","target_language":"en","phrases":[{"concept":"help","text":{"Latn":"Hjälp!"}},{"concept":"call-the-police","text":{"Latn":"Ring polisen!"}},{"concept":"call-an-ambulance","text":{"Latn":"Ring en ambulans!"}},{"concept":"i-need-a-doctor","text":{"Latn":"Jag behöver en läkare"}},{"concept":"where-is-the-pharmacy","text":{"Latn":"Var är apoteket?"}},{"concept":"where-is-the-hospital","text":{"Latn":"Var är sjukhuset?"}},{"concept":"i-feel-sick","text":{"Latn":"Jag mår illa"}},{"concept":"please-help-me","text":{"Latn":"Hjälp mig, tack"}},{"concept":"stop-thief","text":{"Latn":"Stoppa tjuven!"}},{"concept":"it-hurts-here","text":{"Latn":"Det gör ont här"}}],"glosses":[{"lemma":"en:help","gloss":"hjälp; hjälpa","note":"Ensamt är „Help!“ ett rop på hjälp."},{"lemma":"en:call","gloss":"ringa, ropa på"},{"lemma":"en:the","gloss":"den, det (bestämd artikel)","note":"Oböjligt: ett enda ord för den, det och de."},{"lemma":"en:police","gloss":"polis","note":"Alltid singular och med „the“ framför."},{"lemma":"en:a","gloss":"en, ett (obestämd artikel)","note":"Blir „an“ framför en vokal: an ambulance. Engelskan skiljer inte mellan en och ett."},{"lemma":"en:ambulance","gloss":"ambulans"},{"lemma":"en:i","gloss":"jag","note":"Skrivs alltid med stor bokstav."},{"lemma":"en:need","gloss":"behöva"},{"lemma":"en:doctor","gloss":"läkare"},{"lemma":"en:where","gloss":"var"},{"lemma":"en:be","gloss":"vara","note":"Ofta förkortat: I'm = I am, you're = you are, that's = that is."},{"lemma":"en:pharmacy","gloss":"apotek","note":"I Storbritannien säger man också „chemist's“."},{"lemma":"en:hospital","gloss":"sjukhus"},{"lemma":"en:feel","gloss":"känna"},{"lemma":"en:sick","gloss":"sjuk","note":"I Storbritannien betyder „sick“ också att man mår illa."},{"lemma":"en:please","gloss":"snälla","note":"Står i början eller slutet av meningen."},{"lemma":"en:stop","gloss":"stoppa, stanna"},{"lemma":"en:thief","