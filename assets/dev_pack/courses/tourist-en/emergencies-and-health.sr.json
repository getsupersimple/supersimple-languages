{"schema_version":1,"course":"tourist-en","unit":"emergencies-and-health","language":"sr","target_language":"en","phrases":[{"concept":"help","text":{"Latn":"Upomoć!","Cyrl":"Упомоћ!"}},{"concept":"call-the-police","text":{"Latn":"Pozovite policiju!","Cyrl":"Позовите полицију!"}},{"concept":"call-an-ambulance","text":{"Latn":"Pozovite hitnu pomoć!","Cyrl":"Позовите хитну помоћ!"}},{"concept":"i-need-a-doctor","text":{"Latn":"Treba mi lekar","Cyrl":"Треба ми лекар"}},{"concept":"where-is-the-pharmacy","text":{"Latn":"Gde je apoteka?","Cyrl":"Где је апотека?"}},{"concept":"where-is-the-hospital","text":{"Latn":"Gde je bolnica?","Cyrl":"Где је болница?"}},{"concept":"i-feel-sick","text":{"Latn":"Pozlilo mi je","Cyrl":"Позлило ми је"}},{"concept":"please-help-me","text":{"Latn":"Pomozite mi, molim","Cyrl":"Помозите ми, молим"}},{"concept":"stop-thief","text":{"Latn":"Lopov!","Cyrl":"Лопов!"}},{"concept":"it-hurts-here","text":{"Latn":"Boli me ovde","Cyrl":"Боли ме овде"}}],"glosses":[{"lemma":"en:help","gloss":"pomoći, upomoć","note":"Samostalno, „Help!“ je poziv u pomoć."},{"lemma":"en:call","gloss":"pozvati"},{"lemma":"en:the","gloss":"(određeni član)","note":"Ne menja se: jedna reč za sve rodove i brojeve. Srpski nema članove."},{"lemma":"en:police","gloss":"policija","note":"Uvek se koristi sa „the“."},{"lemma":"en:a","gloss":"(neodređeni član)","note":"Pred samoglasnikom postaje „an“: an ambulance. Srpski nema članove."},{"lemma":"en:ambulance","gloss":"hitna pomoć"},{"lemma":"en:i","gloss":"ja","note":"Uvek se piše velikim slovom. „me“ je oblik za objekat."},{"lemma":"en:need","gloss":"trebati"},{"lemma":"en:doctor","gloss":"lekar"},{"lemma":"en:where","gloss":"gde"},{"lemma":"en:be","gloss":"biti","note":"Često se skraćuje: I'm = I am, you're = you are, that's = that is."},{"lemma":"en:pharmacy","gloss":"apoteka","note":"U Velikoj Britaniji se kaže i „chemist's“."},{"lemma":"en:hospital","gloss":"bolnica"},{"lemma":"en:feel","gloss":"osećati se"},{"lemma":"en:sick","gloss":"bolestan","note":"U Velikoj Britaniji „sick“ može značiti i „mučnina“."},{"lemma":"en:please","gloss":"molim","note":"Stavlja se na početak ili na kraj rečenice."},{"lemma":"en:stop","gloss":"stati, zaustaviti"},{"lemma":"en:thief","gloss":"lopov"},{"lemma":"en:it","gloss":"ono, to"},{"lemma":"en:hurt","gloss":"boleti"},{"lemma":"en:here","gloss":"ovde"}]}
