{"schema_version":1,"course":"tourist-en","unit":"essentials-and-politeness","language":"sr","target_language":"en","phrases":[{"concept":"yes","text":{"Latn":"Da","Cyrl":"Да"}},{"concept":"no","text":{"Latn":"Ne","Cyrl":"Не"}},{"concept":"please","text":{"Latn":"Molim","Cyrl":"Молим"}},{"concept":"excuse-me","text":{"Latn":"Izvinite","Cyrl":"Извините"}},{"concept":"sorry","text":{"Latn":"Žao mi je","Cyrl":"Жао ми је"}},{"concept":"youre-welcome","text":{"Latn":"Nema na čemu","Cyrl":"Нема на чему"}},{"concept":"good-evening","text":{"Latn":"Dobro veče","Cyrl":"Добро вече"}},{"concept":"goodbye","text":{"Latn":"Doviđenja","Cyrl":"Довиђења"}},{"concept":"i-dont-understand","text":{"Latn":"Ne razumem","Cyrl":"Не разумем"}},{"concept":"speak-slowly-please","text":{"Latn":"Govorite polako, molim","Cyrl":"Говорите полако, молим"}},{"concept":"can-you-repeat","text":{"Latn":"Možete li da ponovite?","Cyrl":"Можете ли да поновите?"}},{"concept":"i-understand","text":{"Latn":"Razumem","Cyrl":"Разумем"}},{"concept":"what-does-this-mean","text":{"Latn":"Šta ovo znači?","Cyrl":"Шта ово значи?"}},{"concept":"i-dont-know","text":{"Latn":"Ne znam","Cyrl":"Не знам"}},{"concept":"no-thank-you","text":{"Latn":"Ne, hvala","Cyrl":"Не, хвала"}},{"concept":"thank-you-very-much","text":{"Latn":"Mnogo hvala","Cyrl":"Много хвала"}}],"glosses":[{"lemma":"en:yes","gloss":"da"},{"lemma":"en:no","gloss":"ne"},{"lemma":"en:please","gloss":"molim","note":"Stavlja se na početak ili na kraj rečenice."},{"lemma":"en:excuse","gloss":"izviniti","note":"„Excuse me“ se koristi za privlačenje pažnje ili za prolaz."},{"lemma":"en:i","gloss":"ja","note":"Uvek se piše velikim slovom. „me“ je oblik za objekat."},{"lemma":"en:be","gloss":"biti","note":"Često se skraćuje: I'm = I am, you're = you are, that's = that is."},{"lemma":"en:sorry","gloss":"žao mi je"},{"lemma":"en:welcome","gloss":"dobrodošao","note":"„You're welcome“ znači „nema na čemu“."},{"lemma":"en:good","gloss":"dobar"},{"lemma":"en:evening","gloss":"veče"},{"lemma":"en:goodbye","gloss":"doviđenja"},{"lemma":"en:do","gloss":"raditi (pomoćni glagol)","note":"Služi za građenje pitanja i odricanja („Do you…?“, „I don't…“); ne prevodi se."},{"lemma":"en:understand","gloss":"razumeti"},{"lemma":"en:speak","gloss":"govoriti"},{"lemma":"en:slowly","gloss":"sporo"},{"lemma":"en:can","gloss":"moći","note":"„Can I…?“ služi za učtivo traženje dozvole."},{"lemma":"en:you","gloss":"ti, vi","note":"Engleski ima jednu reč za „ti“ i „vi“, i za jedninu i za množinu."},{"lemma":"en:repeat","gloss":"ponoviti"},{"lemma":"en:that","gloss":"to"},{"lemma":"en:what","gloss":"šta, koji"},{"lemma":"en:this","gloss":"ovo"},{"lemma":"en:mean","gloss":"značiti"},{"lemma":"en:know","gloss":"znati"},{"lemma":"en:thank","gloss":"zahvaliti se","note":"„Thank you“ znači „hvala“; „thanks“ je neformalna varijanta."},{"lemma":"en:very","gloss":"veoma"},{"lemma":"en:much","gloss":"mnogo","note":"„How much“ znači „koliko“."}]}
