{"schema_version":1,"course":"tourist-en","unit":"food-and-drink","language":"fr","target_language":"en","phrases":[{"concept":"one-coffee-please","text":{"Latn":"Un café, s'il vous plaît"}},{"concept":"water-please","text":{"Latn":"Un verre d'eau, s'il vous plaît"}},{"concept":"table-for-two","text":{"Latn":"Une table pour deux, s'il vous plaît"}},{"concept":"the-menu-please","text":{"Latn":"La carte, s'il vous plaît"}},{"concept":"the-bill-please","text":{"Latn":"L'addition, s'il vous plaît"}},{"concept":"i-dont-eat-meat","text":{"Latn":"Je ne mange pas de viande"}},{"concept":"without-nuts-please","text":{"Latn":"Sans noix, s'il vous plaît"}},{"concept":"what-do-you-recommend","text":{"Latn":"Que recommandez-vous ?"}},{"concept":"delicious","text":{"Latn":"Délicieux !"}},{"concept":"a-beer-please","text":{"Latn":"Une bière, s'il vous plaît"}},{"concept":"cheers","text":{"Latn":"Santé !"}}],"glosses":[{"lemma":"en:one","gloss":"un, une"},{"lemma":"en:coffee","gloss":"café"},{"lemma":"en:please","gloss":"s'il vous plaît, s'il te plaît","note":"Se place au début ou à la fin de la phrase."},{"lemma":"en:a","gloss":"un, une (article indéfini)","note":"Devient « an » devant une voyelle : an ambulance."},{"lemma":"en:glass","gloss":"verre"},{"lemma":"en:of","gloss":"de","note":"Indique le contenu : « a glass of water » est « un verre d'eau »."},{"lemma":"en:water","gloss":"eau"},{"lemma":"en:table","gloss":"table"},{"lemma":"en:for","gloss":"pour"},{"lemma":"en:two","gloss":"deux"},{"lemma":"en:the","gloss":"le, la, les (article défini)","note":"Invariable : un seul mot pour le, la et les."},{"lemma":"en:menu","gloss":"carte, menu"},{"lemma":"en:bill","gloss":"addition","note":"Au Royaume-Uni, c'est la note au restaurant ; les Américains disent « check »."},{"lemma":"en:i","gloss":"je, moi","note":"S'écrit toujours avec une majuscule. « me » est sa forme complément."},{"lemma":"en:do","gloss":"faire (auxiliaire)","note":"Sert à former les questions et les négations (« Do you…? », « I don't… ») ; il ne se traduit pas."},{"lemma":"en:eat","gloss":"manger"},{"lemma":"en:meat","gloss":"viande"},{"lemma":"en:without","gloss":"sans"},{"lemma":"en:nut","gloss":"noix, fruit à coque"},{"lemma":"en:what","gloss":"quoi, que, quel"},{"lemma":"en:you","gloss":"tu, vous","note":"L'anglais n'a qu'un seul mot pour le tutoiement et le vouvoiement, au singulier comme au pluriel."},{"lemma":"en:recommend","gloss":"recommander"},{"lemma":"en:delicious","gloss":"délicieux"},{"lemma":"en:beer","gloss":"bière"},{"lemma":"en:cheers","gloss":"santé !","note":"Se dit aussi pour remercier, familièrement."}]}
