{"schema_version":1,"course":"tourist-en","unit":"accommodation-and-shopping","language":"sv","target_language":"en","phrases":[{"concept":"i-have-a-reservation","text":{"Latn":"Jag har en bokning"}},{"concept":"how-much-is-this","text":{"Latn":"Vad kostar det här?"}},{"concept":"too-expensive","text":{"Latn":"Det är för dyrt"}},{"concept":"do-you-take-cards","text":{"Latn":"Tar ni emot kort?"}},{"concept":"where-is-the-atm","text":{"Latn":"Var finns bankomaten?"}},{"concept":"do-you-have-a-free-room","text":{"Latn":"Har ni ett ledigt rum?"}},{"concept":"the-key-please","text":{"Latn":"Nyckeln, tack"}},{"concept":"what-time-do-you-open","text":{"Latn":"När öppnar ni?"}},{"concept":"can-i-have-a-receipt","text":{"Latn":"Kan jag få ett kvitto?"}},{"concept":"ill-take-it","text":{"Latn":"Jag tar det"}}],"glosses":[{"lemma":"en:i","gloss":"jag","note":"Skrivs alltid med stor bokstav."},{"lemma":"en:have","gloss":"ha"},{"lemma":"en:a","gloss":"en, ett (obestämd artikel)","note":"Blir „an“ framför en vokal: an ambulance. Engelskan skiljer inte mellan en och ett."},{"lemma":"en:reservation","gloss":"bokning"},{"lemma":"en:how","gloss":"hur"},{"lemma":"en:much","gloss":"mycket","note":"„How much“ är „hur mycket“."},{"lemma":"en:be","gloss":"vara","note":"Ofta förkortat: I'm = I am, you're = you are, that's = that is."},{"lemma":"en:this","gloss":"den här, det här"},{"lemma":"en:too","gloss":"för (alltför)"},{"lemma":"en:expensive","gloss":"dyr"},{"lemma":"en:do","gloss":"göra (hjälpverb)","note":"Bildar frågor och nekanden („Do you…?“, „I don't…“); översätts inte."},{"lemma":"en:you","gloss":"du, ni","note":"Engelskan har bara ett „you“, ingen skillnad mellan „du“ och „ni“."},{"lemma":"en:accept","gloss":"acceptera, ta emot"},{"lemma":"en:card","gloss":"kort"},{"lemma":"en:where","gloss":"var"},{"lemma":"en:the","gloss":"den, det (bestämd artikel)","note":"Oböjligt: ett enda ord för den, det och de."},{"lemma":"en:atm","gloss":"bankomat","note":"Uttalas bokstav för bokstav: A-T-M."},{"lemma":"en:free","gloss":"ledig; gratis","note":"Betyder också „gratis“."},{"lemma":"en:room","gloss":"rum"},{"lemma":"en:key","gloss":"nyckel"},{"lemma":"en:please","gloss":"snälla","note":"Står i början eller slutet av meningen."},{"lemma":"en:what","gloss":"vad"},{"lemma":"en:time","gloss":"tid; klockslag","note":"„What time…?“ är „Hur dags…?“."},{"lemma":"en:open","gloss":"öppna; öppen"},{"lemma":"en:can","gloss":"kunna","note":"„Can I…?“ är den artiga frågan om lov."},{"lemma":"en:receipt","gloss":"kvitto"},{"lemma":"en:will","gloss":"ska (hjälpverb för framtid)","note":"„I'll“ är „I will“; här „Jag tar det“."},{"lemma":"en:take","gloss":"ta"},{"lemma":"en:it","gloss":"det, den"}]}
