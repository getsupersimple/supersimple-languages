{"schema_version":1,"course":"tourist-en","unit":"accommodation-and-shopping","language":"fr","target_language":"en","phrases":[{"concept":"i-have-a-reservation","text":{"Latn":"J'ai une réservation"}},{"concept":"how-much-is-this","text":{"Latn":"Combien ça coûte ?"}},{"concept":"too-expensive","text":{"Latn":"Trop cher"}},{"concept":"do-you-take-cards","text":{"Latn":"Acceptez-vous les cartes ?"}},{"concept":"where-is-the-atm","text":{"Latn":"Où est le distributeur ?"}},{"concept":"do-you-have-a-free-room","text":{"Latn":"Avez-vous une chambre libre ?"}},{"concept":"the-key-please","text":{"Latn":"La clé, s'il vous plaît"}},{"concept":"what-time-do-you-open","text":{"Latn":"À quelle heure ouvrez-vous ?"}},{"concept":"can-i-have-a-receipt","text":{"Latn":"Puis-je avoir un reçu ?"}},{"concept":"ill-take-it","text":{"Latn":"Je le prends"}}],"glosses":[{"lemma":"en:i","gloss":"je, moi","note":"S'écrit toujours avec une majuscule. « me » est sa forme complément."},{"lemma":"en:have","gloss":"avoir"},{"lemma":"en:a","gloss":"un, une (article indéfini)","note":"Devient « an » devant une voyelle : an ambulance."},{"lemma":"en:reservation","gloss":"réservation"},{"lemma":"en:how","gloss":"comment"},{"lemma":"en:much","gloss":"beaucoup","note":"« How much » veut dire « combien »."},{"lemma":"en:be","gloss":"être","note":"Souvent contracté : I'm = I am, you're = you are, that's = that is."},{"lemma":"en:this","gloss":"ceci, ce"},{"lemma":"en:too","gloss":"trop"},{"lemma":"en:expensive","gloss":"cher, coûteux"},{"lemma":"en:do","gloss":"faire (auxiliaire)","note":"Sert à former les questions et les négations (« Do you…? », « I don't… ») ; il ne se traduit pas."},{"lemma":"en:you","gloss":"tu, vous","note":"L'anglais n'a qu'un seul mot pour le tutoiement et le vouvoiement, au singulier comme au pluriel."},{"lemma":"en:accept","gloss":"accepter"},{"lemma":"en:card","gloss":"carte"},{"lemma":"en:where","gloss":"où"},{"lemma":"en:the","gloss":"le, la, les (article défini)","note":"Invariable : un seul mot pour le, la et les."},{"lemma":"en:atm","gloss":"distributeur de billets","note":"Se prononce lettre par lettre : A-T-M."},{"lemma":"en:free","gloss":"libre","note":"Veut aussi dire « gratuit »."},{"lemma":"en:room","gloss":"chambre"},{"lemma":"en:key","gloss":"clé"},{"lemma":"en:please","gloss":"s'il vous plaît, s'il te plaît","note":"Se place au début ou à la fin de la phrase."},{"lemma":"en:what","gloss":"quoi, que, quel"},{"lemma":"en:time","gloss":"heure, temps","note":"« What time… ? » veut dire « À quelle heure… ? »."},{"lemma":"en:open","gloss":"ouvrir"},{"lemma":"en:can","gloss":"pouvoir","note":"« Can I… ? » sert à demander poliment la permission."},{"lemma":"en:receipt","gloss":"reçu, ticket de caisse"},{"lemma":"en:will","gloss":"(auxiliaire du futur)","note":"« I'll » = « I will » ; ici : « je vais le prendre »."},{"lemma":"en:take","gloss":"prendre"},{"lemma":"en:it","gloss":"il, elle, ce, cela"}]}
