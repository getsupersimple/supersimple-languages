{"schema_version":1,"course":"tourist-en","unit":"directions-and-transport","language":"sr","target_language":"en","phrases":[{"concept":"where-is-the-station","text":{"Latn":"Gde je železnička stanica?","Cyrl":"Где је железничка станица?"}},{"concept":"where-is-the-bus-stop","text":{"Latn":"Gde je autobuska stanica?","Cyrl":"Где је аутобуска станица?"}},{"concept":"a-ticket-please","text":{"Latn":"Jednu kartu, molim","Cyrl":"Једну карту, молим"}},{"concept":"how-do-i-get-to-the-centre","text":{"Latn":"Kako da stignem do centra?","Cyrl":"Како да стигнем до центра?"}},{"concept":"is-it-far","text":{"Latn":"Je li daleko?","Cyrl":"Је ли далеко?"}},{"concept":"turn-left","text":{"Latn":"Skrenite levo","Cyrl":"Скрените лево"}},{"concept":"turn-right","text":{"Latn":"Skrenite desno","Cyrl":"Скрените десно"}},{"concept":"go-straight","text":{"Latn":"Idite pravo","Cyrl":"Идите право"}},{"concept":"call-a-taxi","text":{"Latn":"Pozovite taksi, molim","Cyrl":"Позовите такси, молим"}},{"concept":"where-is-the-exit","text":{"Latn":"Gde je izlaz?","Cyrl":"Где је излаз?"}},{"concept":"where-is-the-bathroom","text":{"Latn":"Gde je toalet?","Cyrl":"Где је тоалет?"}},{"concept":"where-is-the-airport","text":{"Latn":"Gde je aerodrom?","Cyrl":"Где је аеродром?"}},{"concept":"i-dont-know-where-i-am","text":{"Latn":"Ne znam gde sam","Cyrl":"Не знам где сам"}},{"concept":"stop-here-please","text":{"Latn":"Stanite ovde, molim","Cyrl":"Станите овде, молим"}},{"concept":"how-long-does-it-take","text":{"Latn":"Koliko dugo traje?","Cyrl":"Колико дуго траје?"}},{"concept":"where-can-i-buy-a-ticket","text":{"Latn":"Gde mogu da kupim kartu?","Cyrl":"Где могу да купим карту?"}},{"concept":"is-it-near","text":{"Latn":"Je li blizu?","Cyrl":"Је ли близу?"}}],"glosses":[{"lemma":"en:where","gloss":"gde"},{"lemma":"en:be","gloss":"biti","note":"Često se skraćuje: I'm = I am, you're = you are, that's = that is."},{"lemma":"en:the","gloss":"(određeni član)","note":"Ne menja se: jedna reč za sve rodove i brojeve. Srpski nema članove."},{"lemma":"en:train","gloss":"voz"},{"lemma":"en:station","gloss":"stanica"},{"lemma":"en:bus","gloss":"autobus"},{"lemma":"en:stop-2","gloss":"stajalište"},{"lemma":"en:a","gloss":"(neodređeni član)","note":"Pred samoglasnikom postaje „an“: an ambulance. Srpski nema članove."},{"lemma":"en:ticket","gloss":"karta"},{"lemma":"en:please","gloss":"molim","note":"Stavlja se na početak ili na kraj rečenice."},{"lemma":"en:how","gloss":"kako"},{"lemma":"en:do","gloss":"raditi (pomoćni glagol)","note":"Služi za građenje pitanja i odricanja („Do you…?“, „I don't…“); ne prevodi se."},{"lemma":"en:i","gloss":"ja","note":"Uvek se piše velikim slovom. „me“ je oblik za objekat."},{"lemma":"en:get","gloss":"stići, doći","note":"„How do I get to…?“ znači „Kako da stignem do…?“."},{"lemma":"en:to","gloss":"do, ka"},{"lemma":"en:centre","gloss":"centar","note":"Britanski pravopis; Amerikanci pišu „center“."},{"lemma":"en:it","gloss":"ono, to"},{"lemma":"en:far","gloss":"daleko"},{"lemma":"en:turn","gloss":"skrenuti"},{"lemma":"en:left","gloss":"levo"},{"lemma":"en:right","gloss":"desno","note":"Znači i „tačno“."},{"lemma":"en:go","gloss":"ići"},{"lemma":"en:straight","gloss":"pravo"},{"lemma":"en:ahead","gloss":"napred"},{"lemma":"en:call","gloss":"pozvati"},{"lemma":"en:taxi","gloss":"taksi"},{"lemma":"en:exit","gloss":"izlaz"},{"lemma":"en:bathroom","gloss":"toalet","note":"U Velikoj Britaniji se kaže i „toilet“ ili „loo“."},{"lemma":"en:airport","gloss":"aerodrom"},{"lemma":"en:know","gloss":"znati"},{"lemma":"en:stop","gloss":"stati, zaustaviti"},{"lemma":"en:here","gloss":"ovde"},{"lemma":"en:long","gloss":"dugo"},{"lemma":"en:take","gloss":"uzeti"},{"lemma":"en:can","gloss":"moći","note":"„Can I…?“ služi za učtivo traženje dozvole."},{"lemma":"en:buy","gloss":"kupiti"},{"lemma":"en:nearby","gloss":"blizu"}]}
