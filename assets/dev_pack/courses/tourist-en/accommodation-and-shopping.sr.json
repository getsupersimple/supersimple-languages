{"schema_version":1,"course":"tourist-en","unit":"accommodation-and-shopping","language":"sr","target_language":"en","phrases":[{"concept":"i-have-a-reservation","text":{"Latn":"Imam rezervaciju","Cyrl":"Имам резервацију"}},{"concept":"how-much-is-this","text":{"Latn":"Koliko ovo košta?","Cyrl":"Колико ово кошта?"}},{"concept":"too-expensive","text":{"Latn":"Preskupo je","Cyrl":"Прескупо је"}},{"concept":"do-you-take-cards","text":{"Latn":"Primate li kartice?","Cyrl":"Примате ли картице?"}},{"concept":"where-is-the-atm","text":{"Latn":"Gde je bankomat?","Cyrl":"Где је банкомат?"}},{"concept":"do-you-have-a-free-room","text":{"Latn":"Imate li slobodnu sobu?","Cyrl":"Имате ли слободну собу?"}},{"concept":"the-key-please","text":{"Latn":"Ključ, molim","Cyrl":"Кључ, молим"}},{"concept":"what-time-do-you-open","text":{"Latn":"Kada otvarate?","Cyrl":"Када отварате?"}},{"concept":"can-i-have-a-receipt","text":{"Latn":"Mogu li dobiti račun?","Cyrl":"Могу ли добити рачун?"}},{"concept":"ill-take-it","text":{"Latn":"Uzeću to","Cyrl":"Узећу то"}}],"glosses":[{"lemma":"en:i","gloss":"ja","note":"Uvek se piše velikim slovom. „me“ je oblik za objekat."},{"lemma":"en:have","gloss":"imati"},{"lemma":"en:a","gloss":"(neodređeni član)","note":"Pred samoglasnikom postaje „an“: an ambulance. Srpski nema članove."},{"lemma":"en:reservation","gloss":"rezervacija"},{"lemma":"en:how","gloss":"kako"},{"lemma":"en:much","gloss":"mnogo","note":"„How much“ znači „koliko“."},{"lemma":"en:be","gloss":"biti","note":"Često se skraćuje: I'm = I am, you're = you are, that's = that is."},{"lemma":"en:this","gloss":"ovo"},{"lemma":"en:too","gloss":"previše"},{"lemma":"en:expensive","gloss":"skup"},{"lemma":"en:do","gloss":"raditi (pomoćni glagol)","note":"Služi za građenje pitanja i odricanja („Do you…?“, „I don't…“); ne prevodi se."},{"lemma":"en:you","gloss":"ti, vi","note":"Engleski ima jednu reč za „ti“ i „vi“, i za jedninu i za množinu."},{"lemma":"en:accept","gloss":"prihvatiti"},{"lemma":"en:card","gloss":"kartica"},{"lemma":"en:where","gloss":"gde"},{"lemma":"en:the","gloss":"(određeni član)","note":"Ne menja se: jedna reč za sve rodove i brojeve. Srpski nema članove."},{"lemma":"en:atm","gloss":"bankomat","note":"Izgovara se slovo po slovo: A-T-M."},{"lemma":"en:free","gloss":"slobodan","note":"Znači i „besplatan“."},{"lemma":"en:room","gloss":"soba"},{"lemma":"en:key","gloss":"ključ"},{"lemma":"en:please","gloss":"molim","note":"Stavlja se na početak ili na kraj rečenice."},{"lemma":"en:what","gloss":"šta, koji"},{"lemma":"en:time","gloss":"vreme","note":"„What time…?“ znači „U koliko sati…?“."},{"lemma":"en:open","gloss":"otvarati (se)"},{"lemma":"en:can","gloss":"moći","note":"„Can I…?“ služi za učtivo traženje dozvole."},{"lemma":"en:receipt","gloss":"račun (potvrda o plaćanju)"},{"lemma":"en:will","gloss":"(pomoćni glagol za budućnost)","note":"„I'll“ = „I will“; ovde znači „uzeću“."},{"lemma":"en:take","gloss":"uzeti"},{"lemma":"en:it","gloss":"ono, to"}]}
