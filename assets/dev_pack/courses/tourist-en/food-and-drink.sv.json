{"schema_version":1,"course":"tourist-en","unit":"food-and-drink","language":"sv","target_language":"en","phrases":[{"concept":"one-coffee-please","text":{"Latn":"En kaffe, tack"}},{"concept":"water-please","text":{"Latn":"Ett glas vatten, tack"}},{"concept":"table-for-two","text":{"Latn":"Ett bord för två, tack"}},{"concept":"the-menu-please","text":{"Latn":"Menyn, tack"}},{"concept":"the-bill-please","text":{"Latn":"Notan, tack"}},{"concept":"i-dont-eat-meat","text":{"Latn":"Jag äter inte kött"}},{"concept":"without-nuts-please","text":{"Latn":"Utan nötter, tack"}},{"concept":"what-do-you-recommend","text":{"Latn":"Vad rekommenderar du?"}},{"concept":"delicious","text":{"Latn":"Gott!"}},{"concept":"a-beer-please","text":{"Latn":"En öl, tack"}},{"concept":"cheers","text":{"Latn":"Skål!"}}],"glosses":[{"lemma":"en:one","gloss":"en, ett"},{"lemma":"en:coffee","gloss":"kaffe"},{"lemma":"en:please","gloss":"snälla","note":"Står i början eller slutet av meningen."},{"lemma":"en:a","gloss":"en, ett (obestämd artikel)","note":"Blir „an“ framför en vokal: an ambulance. Engelskan skiljer inte mellan en och ett."},{"lemma":"en:glass","gloss":"glas"},{"lemma":"en:of","gloss":"av","note":"„A glass of water“ är „ett glas vatten“: svenskan har inget ord för „of“."},{"lemma":"en:water","gloss":"vatten"},{"lemma":"en:table","gloss":"bord"},{"lemma":"en:for","gloss":"för"},{"lemma":"en:two","gloss":"två"},{"lemma":"en:the","gloss":"den, det (bestämd artikel)","note":"Oböjligt: ett enda ord för den, det och de."},{"lemma":"en:menu","gloss":"meny"},{"lemma":"en:bill","gloss":"nota","note":"I Storbritannien är det notan på restaurang; amerikaner säger „check“."},{"lemma":"en:i","gloss":"jag","note":"Skrivs alltid med stor bokstav."},{"lemma":"en:do","gloss":"göra (hjälpverb)","note":"Bildar frågor och nekanden („Do you…?“, „I don't…“); översätts inte."},{"lemma":"en:eat","gloss":"äta"},{"lemma":"en:meat","gloss":"kött"},{"lemma":"en:without","gloss":"utan"},{"lemma":"en:nut","gloss":"nöt"},{"lemma":"en:what","gloss":"vad"},{"lemma":"en:you","gloss":"du, ni","note":"Engelskan har bara ett „you“, ingen skillnad mellan „du“ och „ni“."},{"lemma":"en:recommend","gloss":"rekommendera"},{"lemma":"en:delicious","gloss":"god, läcker"},{"lemma":"en:beer","gloss":"öl"},{"lemma":"en:cheers","gloss":"skål!","note":"Används informellt också för att tacka."}]}
