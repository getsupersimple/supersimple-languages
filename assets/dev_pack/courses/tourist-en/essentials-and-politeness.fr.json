{"schema_version":1,"course":"tourist-en","unit":"essentials-and-politeness","language":"fr","target_language":"en","phrases":[{"concept":"yes","text":{"Latn":"Oui"}},{"concept":"no","text":{"Latn":"Non"}},{"concept":"please","text":{"Latn":"S'il vous plaît"}},{"concept":"excuse-me","text":{"Latn":"Excusez-moi"}},{"concept":"sorry","text":{"Latn":"Pardon"}},{"concept":"youre-welcome","text":{"Latn":"De rien"}},{"concept":"good-evening","text":{"Latn":"Bonsoir"}},{"concept":"goodbye","text":{"Latn":"Au revoir"}},{"concept":"i-dont-understand","text":{"Latn":"Je ne comprends pas"}},{"concept":"speak-slowly-please","text":{"Latn":"Parlez lentement, s'il vous plaît"}},{"concept":"can-you-repeat","text":{"Latn":"Pouvez-vous répéter ?"}},{"concept":"i-understand","text":{"Latn":"Je comprends"}},{"concept":"what-does-this-mean","text":{"Latn":"Que signifie ça ?"}},{"concept":"i-dont-know","text":{"Latn":"Je ne sais pas"}},{"concept":"no-thank-you","text":{"Latn":"Non, merci"}},{"concept":"thank-you-very-much","text":{"Latn":"Merci beaucoup"}}],"glosses":[{"lemma":"en:yes","gloss":"oui"},{"lemma":"en:no","gloss":"non"},{"lemma":"en:please","gloss":"s'il vous plaît, s'il te plaît","note":"Se place au début ou à la fin de la phrase."},{"lemma":"en:excuse","gloss":"excuser, pardonner","note":"« Excuse me » sert à attirer l'attention ou à passer."},{"lemma":"en:i","gloss":"je, moi","note":"S'écrit toujours avec une majuscule. « me » est sa forme complément."},{"lemma":"en:be","gloss":"être","note":"Souvent contracté : I'm = I am, you're = you are, that's = that is."},{"lemma":"en:sorry","gloss":"désolé(e)"},{"lemma":"en:welcome","gloss":"bienvenu(e)","note":"« You're welcome » veut dire « de rien »."},{"lemma":"en:good","gloss":"bon"},{"lemma":"en:evening","gloss":"soir"},{"lemma":"en:goodbye","gloss":"au revoir"},{"lemma":"en:do","gloss":"faire (auxiliaire)","note":"Sert à former les questions et les négations (« Do you…? », « I don't… ») ; il ne se traduit pas."},{"lemma":"en:understand","gloss":"comprendre"},{"lemma":"en:speak","gloss":"parler"},{"lemma":"en:slowly","gloss":"lentement"},{"lemma":"en:can","gloss":"pouvoir","note":"« Can I… ? » sert à demander poliment la permission."},{"lemma":"en:you","gloss":"tu, vous","note":"L'anglais n'a qu'un seul mot pour le tutoiement et le vouvoiement, au singulier comme au pluriel."},{"lemma":"en:repeat","gloss":"répéter"},{"lemma":"en:that","gloss":"cela, ça"},{"lemma":"en:what","gloss":"quoi, que, quel"},{"lemma":"en:this","gloss":"ceci, ce"},{"lemma":"en:mean","gloss":"signifier"},{"lemma":"en:know","gloss":"savoir"},{"lemma":"en:thank","gloss":"remercier","note":"« Thank you » veut dire « merci » ; « thanks » est la version familière."},{"lemma":"en:very","gloss":"très"},{"lemma":"en:much","gloss":"beaucoup","note":"« How much » veut dire « combien »."}]}
