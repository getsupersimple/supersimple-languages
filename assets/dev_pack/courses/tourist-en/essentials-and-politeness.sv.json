{"schema_version":1,"course":"tourist-en","unit":"essentials-and-politeness","language":"sv","target_language":"en","phrases":[{"concept":"yes","text":{"Latn":"Ja"}},{"concept":"no","text":{"Latn":"Nej"}},{"concept":"please","text":{"Latn":"Snälla"}},{"concept":"excuse-me","text":{"Latn":"Ursäkta"}},{"concept":"sorry","text":{"Latn":"Förlåt"}},{"concept":"youre-welcome","text":{"Latn":"Ingen orsak"}},{"concept":"good-evening","text":{"Latn":"God kväll"}},{"concept":"goodbye","text":{"Latn":"Hej då"}},{"concept":"i-dont-understand","text":{"Latn":"Jag förstår inte"}},{"concept":"speak-slowly-please","text":{"Latn":"Tala långsamt, tack"}},{"concept":"can-you-repeat","text":{"Latn":"Kan du upprepa det?"}},{"concept":"i-understand","text":{"Latn":"Jag förstår"}},{"concept":"what-does-this-mean","text":{"Latn":"Vad betyder det här?"}},{"concept":"i-dont-know","text":{"Latn":"Jag vet inte"}},{"concept":"no-thank-you","text":{"Latn":"Nej, tack"}},{"concept":"thank-you-very-much","text":{"Latn":"Tack så mycket"}}],"glosses":[{"lemma":"en:yes","gloss":"ja"},{"lemma":"en:no","gloss":"nej; ingen"},{"lemma":"en:please","gloss":"snälla","note":"Står i början eller slutet av meningen."},{"lemma":"en:excuse","gloss":"ursäkta","note":"„Excuse me“ används för att fånga uppmärksamhet eller ta sig förbi."},{"lemma":"en:i","gloss":"jag","note":"Skrivs alltid med stor bokstav."},{"lemma":"en:be","gloss":"vara","note":"Ofta förkortat: I'm = I am, you're = you are, that's = that is."},{"lemma":"en:sorry","gloss":"förlåt; ledsen"},{"lemma":"en:welcome","gloss":"välkommen","note":"„You're welcome“ är „Ingen orsak“."},{"lemma":"en:good","gloss":"bra, god"},{"lemma":"en:evening","gloss":"kväll"},{"lemma":"en:goodbye","gloss":"hej då"},{"lemma":"en:do","gloss":"göra (hjälpverb)","note":"Bildar frågor och nekanden („Do you…?“, „I don't…“); översätts inte."},{"lemma":"en:understand","gloss":"förstå"},{"lemma":"en:speak","gloss":"tala"},{"lemma":"en:slowly","gloss":"långsamt"},{"lemma":"en:can","